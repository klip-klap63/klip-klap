<style>
  .mentions-page {
    padding: 140px 0 120px;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .page-eyebrow {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 6vw, 56px);
    color: #fff;
    line-height: 1;
    letter-spacing: 2px;
    margin-bottom: 64px;
  }

  .mentions-content {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  section h2 {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.5px;
    color: var(--color-primary);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  section p {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    color: #999;
    line-height: 1.8;
  }

  section p a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  section p + p {
    margin-top: 8px;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }

    .mentions-page {
      padding: 110px 0 80px;
    }
  }
</style>
