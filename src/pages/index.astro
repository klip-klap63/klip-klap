---
import BaseLayout from '../layouts/BaseLayout.astro';
import { heroVideo, services } from '../data/services';
---

<BaseLayout
  title="KLIP KLAP — Vidéaste Clermont-Ferrand | Live Multicam, Drone DGAC, Clips Auvergne"
  description="KLIP KLAP — Production audiovisuelle à Clermont-Ferrand et en Auvergne. Live multicam jusqu'à 8 caméras, télépilote drone diplômé DGAC Puy-de-Dôme, clips musicaux, film corporate."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-video-wrapper">
      <iframe
        src={heroVideo.vimeo_embed}
        frameborder="0"
        allow="autoplay; fullscreen"
        title="KLIP KLAP — Showreel"
        aria-hidden="true"
      ></iframe>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">PRODUCTION AUDIOVISUELLE</p>
      <h1 class="hero-title-split">
        <span>KLIP</span>
        <span class="hero-inline-media" aria-hidden="true">
          <iframe
            src="https://player.vimeo.com/video/1188799456?background=1&autoplay=1&loop=1&muted=1&playlist=1188799456"
            frameborder="0"
            allow="autoplay"
          ></iframe>
        </span>
        <span>KLAP</span>
      </h1>
      <p class="hero-sub">Live multicam — Drone — Clips — Corporate</p>
      <div class="hero-ctas">
        <a href="/services" class="btn-primary">Nos services</a>
        <a href="/contact" class="btn-secondary">Prendre contact</a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value">8</span>
        <span class="stat-label">caméras max</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">DGAC</span>
        <span class="stat-label">télépilote diplômé</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">360°</span>
        <span class="stat-label">prestation complète</span>
      </div>
    </div>
  </section>

  <!-- SERVICES APERCU -->
  <section class="services-preview" id="services-preview">
    <div class="container">
      <h2 class="section-title">Mes prestations</h2>
    </div>
    <div class="services-track" id="services-track">
      {services.map((s) => (
        <a href={`/services#${s.id}`} class="service-card">
          <h3 class="service-name">{s.titre}</h3>
          <p class="service-desc">{s.description.slice(0, 80)}...</p>
          <span class="service-arrow">—</span>
        </a>
      ))}
    </div>
  </section>
  <div class="services-cta container">
    <a href="/services" class="btn-secondary">Voir tous les services</a>
  </div>

  <!-- A PROPOS -->
  <section class="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <p class="about-body">
            KLIP KLAP conçoit vos images cinématographiques où le regard, le temps et le contraste
            occupent une place centrale. Mon travail consiste à transformer une intention en récit
            visuel, en croisant ma vision créative avec celle du client. À travers des projets pour
            des artistes, des événements, des entreprises, le sport ou l'automobile, je cherche à
            créer des images qui racontent, qui respirent, et qui laissent une trace.
          </p>
          <a href="/contact" class="btn-primary" style="margin-top: 32px; display: inline-block;">Travaillons ensemble</a>
        </div>
        <div class="about-photo">
          <img
            src="/photo_profil.jpg"
            alt="Ronan — Vidéaste et télépilote drone Klip Klap, Châtel-Guyon Auvergne"
            loading="lazy"
            width="480"
            height="600"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PROJETS SELECTION -->
  <section class="projets-selection">
    <div class="container">
      <h2 class="section-title-projets">SÉLECTION</h2>
    </div>

    <!-- Runner latéral -->
    <div class="projets-runner-outer" aria-hidden="true">
      <div class="projets-runner" id="projets-runner">
        <span>PROJETS — SÉLECTION — PROJETS — SÉLECTION — PROJETS — SÉLECTION — PROJETS — SÉLECTION — </span>
        <span>PROJETS — SÉLECTION — PROJETS — SÉLECTION — PROJETS — SÉLECTION — PROJETS — SÉLECTION — </span>
      </div>
    </div>

    <div class="projets-grid-home">
      <a href="/projets/fc-chatel-rc-riorges-feminin" class="projet-card-home">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/zPpQNie58MY/maxresdefault.jpg"
            alt="FC CHATEL — RC RIORGES FÉMININ"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">FC CHATEL — RC RIORGES FÉMININ</p>
          <span class="card-badge">LIVE MULTICAM</span>
        </div>
      </a>

      <a href="/projets/making-of-yavanti-episode-7" class="projet-card-home">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/sHLetqUg2T8/maxresdefault.jpg"
            alt="MAKING-OF Y'AVANTI EPISODE 7"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">MAKING-OF Y'AVANTI EPISODE 7</p>
          <span class="card-badge">CORPORATE</span>
        </div>
      </a>

      <a href="/projets/halleatoires-2-aftermovie" class="projet-card-home">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/dWNUEOTkceA/maxresdefault.jpg"
            alt="HALLÉATOIRES 2 — AFTERMOVIE"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">HALLÉATOIRES 2 — AFTERMOVIE</p>
          <span class="card-badge">RÉSEAUX SOCIAUX</span>
        </div>
      </a>

      <a href="/projets/stjepan-scarabe" class="projet-card-home">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/EjVWHof0bkA/maxresdefault.jpg"
            alt="STJEPAN — SCARABÉ"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">STJEPAN — SCARABÉ</p>
          <span class="card-badge">CLIPS</span>
        </div>
      </a>
    </div>

    <div class="projets-cta-wrap">
      <a href="/projets" class="btn-secondary">VOIR TOUS LES PROJETS</a>
    </div>
  </section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    if (window.innerWidth < 768) return;

    gsap.registerPlugin(ScrollTrigger);

    // --- Scroll horizontal des prestations ---
    var track = document.getElementById('services-track');
    var preview = document.getElementById('services-preview');
    if (track && preview) {
      // Recalcul après rendu
      var travelX = track.scrollWidth - window.innerWidth;
      if (travelX > 0) {
        gsap.to(track, {
          x: -travelX,
          ease: 'none',
          scrollTrigger: {
            trigger: preview,
            start: 'top top+=72',
            end: function () { return '+=' + travelX; },
            pin: true,
            scrub: 0.6,
            invalidateOnRefresh: true,
          }
        });
      }
    }

    // --- Runner latéral sur la section projets ---
    var runner = document.getElementById('projets-runner');
    var selection = document.querySelector('.projets-selection');
    if (runner && selection) {
      gsap.to(runner, {
        x: '-50%',
        ease: 'none',
        scrollTrigger: {
          trigger: selection,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1.5,
        }
      });
    }
  });
</script>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-video-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-video-wrapper iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100vw, 177.78vh);
    height: max(56.25vw, 100vh);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 0 20px;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .hero-title-split {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, 120px);
    color: #fff;
    line-height: 0.9;
    letter-spacing: 4px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2vw, 28px);
  }

  .hero-inline-media {
    display: block;
    width: clamp(120px, 13vw, 185px);
    height: clamp(68px, 7.3vw, 104px);
    overflow: hidden;
    border-radius: 4px;
    position: relative;
    flex-shrink: 0;
  }

  .hero-inline-media iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200%;
    height: 200%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    border: none;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 48px;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-stats {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
  }

  /* BUTTONS */
  .btn-primary {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-primary);
    background: rgba(245, 200, 0, 0.15);
    backdrop-filter: blur(10px);
    padding: 14px 32px;
    border: 1px solid rgba(245, 200, 0, 0.3);
    border-radius: 2px;
    box-shadow: inset 0 1px 0 rgba(245, 200, 0, 0.25);
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .btn-primary:hover {
    background: rgba(245, 200, 0, 0.28);
    border-color: rgba(245, 200, 0, 0.55);
  }

  .btn-secondary {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    padding: 14px 32px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }

  .btn-secondary:hover {
    border-color: rgba(245, 200, 0, 0.4);
    color: var(--color-primary);
    background: rgba(245, 200, 0, 0.05);
  }

  /* CONTAINER */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* SECTION TYPOGRAPHY */
  .section-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .section-title {
    font-family: var(--font-body);
    font-size: clamp(32px, 4vw, 42px);
    font-weight: 300;
    color: #fff;
    letter-spacing: -0.5px;
    margin-bottom: 56px;
  }

  /* SERVICES PREVIEW */
  .services-preview {
    padding: 120px 0 48px;
    overflow: hidden;
  }

  .services-track {
    display: flex;
    flex-wrap: nowrap;
    gap: 12px;
    padding: 0 32px;
    will-change: transform;
  }

  .service-card {
    flex: 0 0 clamp(240px, 22vw, 320px);
    background: rgba(255, 255, 255, 0.035);
    backdrop-filter: blur(20px) saturate(200%) brightness(1.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), inset 0 -1px 0 rgba(0, 0, 0, 0.3);
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: background var(--transition-base), border-color var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245, 200, 0, 0.35), transparent);
    pointer-events: none;
  }

  .service-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, transparent 100%);
    pointer-events: none;
    border-radius: 16px 16px 0 0;
  }

  .service-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .service-card:hover .service-arrow {
    color: var(--color-primary);
    transform: translateX(4px);
  }

  .service-num {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 3px;
    color: var(--color-primary);
  }

  .service-name {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    color: #fff;
    line-height: 1.3;
  }

  .service-desc {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    color: var(--color-text-subtle);
    line-height: 1.6;
    flex: 1;
  }

  .service-arrow {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-border);
    transition: color var(--transition-fast), transform var(--transition-fast);
    align-self: flex-end;
  }

  .services-cta {
    margin-top: 32px;
    margin-bottom: 80px;
    text-align: center;
  }

  /* A PROPOS */
  .about {
    padding: 120px 0;
    border-top: 1px solid var(--color-border);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-body {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    color: #999;
    line-height: 1.8;
  }

  .about-photo img {
    width: 100%;
    max-width: 480px;
    height: 580px;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(20%);
  }

  /* RUNNER latéral */
  .projets-runner-outer {
    overflow: hidden;
    padding: 20px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 48px;
  }

  .projets-runner {
    display: flex;
    white-space: nowrap;
    width: max-content;
    will-change: transform;
  }

  .projets-runner span {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* PROJETS SELECTION */
  .projets-selection {
    padding: 80px 0 120px;
    border-top: 1px solid var(--color-border);
  }

  .projets-selection .container {
    margin-bottom: 0;
  }

  .section-title-projets {
    font-family: var(--font-body);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 300;
    color: #fff;
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .projets-grid-home {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 0 32px;
    max-width: 1280px;
    margin: 0 auto;
  }

  .projet-card-home {
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    overflow: hidden;
    background: #0d0d0d;
    border: 1px solid var(--color-border);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .projet-card-home:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 200, 0, 0.35);
  }

  .card-thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px 8px 0 0;
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }

  .projet-card-home:hover .card-thumb img {
    transform: scale(1.05);
  }

  .card-info {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-titre {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.4;
  }

  .card-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 3px 8px;
    align-self: flex-start;
  }

  .projets-cta-wrap {
    margin-top: 48px;
    text-align: center;
  }

  @media (max-width: 1024px) and (min-width: 769px) {
    .projets-grid-home {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }

    .hero-title-split {
      flex-direction: column;
      gap: 12px;
    }

    .hero-inline-media {
      width: 160px;
      height: 90px;
    }

    .hero-stats {
      gap: 20px;
      bottom: 24px;
    }

    .stat-value {
      font-size: 22px;
    }

    /* Services : scroll horizontal désactivé sur mobile */
    .services-track {
      flex-wrap: wrap;
      padding: 0 20px;
    }

    .service-card {
      flex: 0 0 100%;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .about-photo {
      order: -1;
    }

    .about-photo img {
      height: 360px;
      max-width: 100%;
    }

    .projets-grid-home {
      grid-template-columns: 1fr;
      padding: 0 20px;
    }

    /* Runner désactivé sur mobile */
    .projets-runner-outer {
      display: none;
    }
  }
</style>
