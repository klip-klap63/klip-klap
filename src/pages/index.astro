---
import BaseLayout from '../layouts/BaseLayout.astro';
import { heroVideo, services } from '../data/services';
---

<BaseLayout
  title="KLIP KLAP — Vidéaste Clermont-Ferrand | Live Multicam, Drone DGAC, Clips Auvergne"
  description="KLIP KLAP — Production audiovisuelle à Clermont-Ferrand et en Auvergne. Live multicam, télépilote drone diplômé DGAC Puy-de-Dôme, clips musicaux, film corporate."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-video-wrapper">
      <iframe
        src={heroVideo.vimeo_embed}
        frameborder="0"
        allow="autoplay; fullscreen"
        title="KLIP KLAP — Showreel"
        aria-hidden="true"
      ></iframe>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Production audiovisuelle</p>
      <h1 class="hero-title">KLIP KLAP</h1>
      <p class="hero-sub">Live multicam — Drone — Clips — Corporate</p>
      <div class="hero-ctas">
        <a href="/services" class="btn-primary">Prestations</a>
        <a href="/contact" class="btn-secondary">Prendre contact</a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value">LIVE</span>
        <span class="stat-label">multicam</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">DGAC</span>
        <span class="stat-label">télépilote diplômé</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">360°</span>
        <span class="stat-label">prestation complète</span>
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="services-preview" id="services-preview">
    <div class="services-pin-container">
      <h2 class="services-label">Mes prestations</h2>
      <div class="services-list" id="services-list">
        {services.map((s, i) => (
          <a
            href={`/services#${s.id}`}
            class:list={['service-item', { 'service-item--hidden': i > 0 }]}
          >
            {i > 0 && <span class="service-divider" aria-hidden="true"></span>}
            <h3 class="service-name">{s.titre}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="services-cta container">
    <a href="/services" class="btn-secondary">Voir toutes les prestations</a>
  </div>

  <!-- A PROPOS -->
  <section class="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <p class="about-eyebrow">KLIP KLAP</p>
          <p class="about-body">
            KLIP KLAP conçoit vos images cinématographiques où le regard, le temps et le contraste
            occupent une place centrale. Mon travail consiste à transformer une intention en récit
            visuel, en croisant ma vision créative avec celle du client. À travers des projets pour
            des artistes, des événements, des entreprises, le sport ou l'automobile, je cherche à
            créer des images qui racontent, qui respirent, et qui laissent une trace.
          </p>
          <a href="/contact" class="btn-primary" style="margin-top: 32px; display: inline-block;">Travaillons ensemble</a>
        </div>
        <div class="about-photo">
          <img
            src="/photo_profil.jpg"
            alt="Ronan — Vidéaste et télépilote drone Klip Klap, Châtel-Guyon Auvergne"
            loading="lazy"
            width="480"
            height="600"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PROJETS SELECTION -->
  <section class="projets-selection" id="projets-selection">
    <div class="container">
      <h2 class="section-title-projets">SÉLECTION</h2>
    </div>

    <div class="projets-scroll-outer">
    <div class="projets-grid-home" id="projets-scroll-track">
      <a href="/projets/fc-chatel-rc-riorges-feminin" class="projet-card-home">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/zPpQNie58MY/maxresdefault.jpg"
            alt="FC CHATEL — RC RIORGES FÉMININ"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">FC CHATEL — RC RIORGES FÉMININ</p>
          <span class="card-badge">Live multicam</span>
        </div>
      </a>

      <a href="/projets/making-of-yavanti-episode-7" class="projet-card-home">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/sHLetqUg2T8/maxresdefault.jpg"
            alt="MAKING-OF Y'AVANTI EPISODE 7"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">MAKING-OF Y'AVANTI EPISODE 7</p>
          <span class="card-badge">Corporate</span>
        </div>
      </a>

      <a href="/projets/halleatoires-2-aftermovie" class="projet-card-home">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/dWNUEOTkceA/maxresdefault.jpg"
            alt="HALLÉATOIRES 2 — AFTERMOVIE"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">HALLÉATOIRES 2 — AFTERMOVIE</p>
          <span class="card-badge">Réseaux sociaux</span>
        </div>
      </a>

      <a href="/projets/stjepan-scarabe" class="projet-card-home">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/EjVWHof0bkA/maxresdefault.jpg"
            alt="STJEPAN — SCARABÉ"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">STJEPAN — SCARABÉ</p>
          <span class="card-badge">Clips</span>
        </div>
      </a>
    </div>

    </div><!-- /projets-scroll-outer -->

    <div class="projets-cta-wrap">
      <a href="/projets" class="btn-secondary">Voir tous les projets</a>
    </div>
  </section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    if (window.innerWidth < 768) return;

    gsap.registerPlugin(ScrollTrigger);

    // --- Prestations : pinning + révélation séquentielle ---
    var preview = document.getElementById('services-preview');
    var items = document.querySelectorAll('.service-item');

    if (preview && items.length > 1) {
      var pinDuration = (items.length - 1) * 280;

      var tl = gsap.timeline({
        scrollTrigger: {
          trigger: preview,
          start: 'top top+=72',
          end: '+=' + pinDuration,
          pin: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
        }
      });

      // Révèle items 1-4 séquentiellement + flou progressif du fond
      tl.fromTo(preview,
        { backdropFilter: 'blur(0px)' },
        { backdropFilter: 'blur(16px)', ease: 'none', duration: (items.length - 1) * 0.24 + 0.12 },
        0
      );
      for (var i = 1; i < items.length; i++) {
        tl.to(items[i], {
          opacity: 1,
          duration: 0.06,
          ease: 'none',
        }, (i - 1) * 0.24);
      }
    }

    // --- Sélection : scroll horizontal piloté par le scroll vertical ---
    var selection = document.getElementById('projets-selection');
    var track = document.getElementById('projets-scroll-track');

    if (selection && track) {
      gsap.to(track, {
        x: function() { return -(track.scrollWidth - window.innerWidth); },
        ease: 'none',
        scrollTrigger: {
          trigger: selection,
          start: 'top top+=72',
          end: function() { return '+=' + (track.scrollWidth - window.innerWidth); },
          pin: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
        }
      });
    }
  });
</script>
</BaseLayout>

<style>
  /* ═══ HERO ═══ */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-video-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-video-wrapper iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100vw, 177.78vh);
    height: max(56.25vw, 100vh);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 0 20px;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, 120px);
    color: #fff;
    line-height: 0.9;
    letter-spacing: 4px;
    margin-bottom: 20px;
    text-align: center;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-muted);
    margin-bottom: 48px;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-stats {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
  }

  /* ═══ BOUTONS ═══ */
  .btn-primary {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    color: #000;
    background: var(--color-primary);
    padding: 14px 32px;
    border: none;
    border-radius: 2px;
    transition: background var(--transition-fast);
  }

  .btn-primary:hover {
    background: var(--color-primary-glow);
  }

  .btn-secondary {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    color: #fff;
    background: transparent;
    padding: 14px 32px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* ═══ CONTAINER ═══ */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ═══ PRESTATIONS ═══ */
  .services-preview {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.88);
  }

  .services-pin-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    text-align: center;
  }

  .services-label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-primary);
    margin-bottom: 56px;
    text-align: center;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .service-item {
    display: block;
    text-decoration: none;
    color: inherit;
    text-align: center;
    width: 100%;
  }

  /* Desktop : items 1-4 cachés jusqu'à révélation par GSAP */
  .service-item--hidden {
    opacity: 0;
  }

  @media (max-width: 768px) {
    .service-item--hidden {
      opacity: 1;
    }
  }

  .service-divider {
    display: block;
    width: 48px;
    height: 1px;
    background: var(--color-border);
    margin: 24px auto;
  }

  .service-name {
    font-family: var(--font-body);
    font-size: clamp(48px, 7vw, 100px);
    font-weight: 200;
    color: #fff;
    line-height: 0.92;
    letter-spacing: -2px;
    transition: color var(--transition-fast);
    text-align: center;
  }

  .service-item:hover .service-name {
    color: var(--color-primary);
  }

  .services-cta {
    margin-top: 56px;
    margin-bottom: 120px;
  }

  /* ═══ À PROPOS ═══ */
  .about {
    padding: 120px 0;
    border-top: 1px solid var(--color-border);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-eyebrow {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-primary);
    margin-bottom: 20px;
  }

  .about-body {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 300;
    color: #999;
    line-height: 1.8;
  }

  .about-photo img {
    width: 100%;
    max-width: 480px;
    height: 580px;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(20%);
  }

  /* ═══ SÉLECTION PROJETS ═══ */
  .projets-selection {
    padding: 80px 0 0;
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }

  .projets-selection .container {
    margin-bottom: 40px;
  }

  .section-title-projets {
    font-family: var(--font-body);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 300;
    color: #fff;
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .projets-scroll-outer {
    overflow: hidden;
  }

  /* Desktop : piste horizontale débordante */
  .projets-grid-home {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 16px;
    padding: 0 32px 80px;
    will-change: transform;
  }

  .projets-grid-home .projet-card-home {
    flex: 0 0 42vw;
  }

  .projet-card-home {
    display: flex;
    flex-direction: column;
    border-radius: 4px;
    overflow: hidden;
    background: #0d0d0d;
    border: 1px solid var(--color-border);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .projet-card-home:hover {
    transform: translateY(-4px);
    border-color: rgba(245, 200, 0, 0.35);
  }

  .card-thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }

  .projet-card-home:hover .card-thumb img {
    transform: scale(1.05);
  }

  .card-info {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-titre {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    color: #fff;
    line-height: 1.4;
  }

  .card-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 3px 8px;
    align-self: flex-start;
  }

  .projets-cta-wrap {
    margin-top: 48px;
    text-align: center;
  }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }

    .hero-stats {
      gap: 20px;
      bottom: 24px;
    }

    .stat-value {
      font-size: 22px;
    }

    .services-preview {
      padding: 80px 0 60px;
    }

    .services-pin-container {
      padding: 0 20px;
    }

    .service-name {
      font-size: clamp(28px, 8vw, 40px);
    }

    .services-cta {
      margin-bottom: 80px;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .about-photo {
      order: -1;
    }

    .about-photo img {
      height: 360px;
      max-width: 100%;
    }

    .projets-grid-home {
      flex-direction: column;
      padding: 0 20px 60px;
    }

    .projets-grid-home .projet-card-home {
      flex: 0 0 auto;
      width: 100%;
    }
  }
</style>
