---
import BaseLayout from '../layouts/BaseLayout.astro';
import { heroVideo, services } from '../data/services';
import { projets } from '../data/projets';
const projetsJSON = JSON.stringify(projets);
---

<BaseLayout
  title="KLIP KLAP — Vidéaste Clermont-Ferrand | Live Multicam, Drone DGAC, Clips Auvergne"
  description="KLIP KLAP — Production audiovisuelle à Clermont-Ferrand et en Auvergne. Live multicam, télépilote drone diplômé DGAC Puy-de-Dôme, clips musicaux, film corporate."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-video-wrapper">
      <iframe
        src={heroVideo.vimeo_embed}
        frameborder="0"
        allow="autoplay; fullscreen"
        title="KLIP KLAP — Showreel"
        aria-hidden="true"
      ></iframe>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Production audiovisuelle</p>
      <h1 class="hero-title">KLIP KLAP</h1>
      <p class="hero-sub">Live multicam — Drone — Clips — Corporate</p>
      <div class="hero-ctas">
        <a href="/services" class="btn-primary">Prestations</a>
        <a href="/contact" class="btn-secondary">Prendre contact</a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value">LIVE</span>
        <span class="stat-label">Multicam</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">DGAC</span>
        <span class="stat-label">Télépilote diplômé</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">360°</span>
        <span class="stat-label">Prestation complète</span>
      </div>
    </div>
  </section>

  <!-- PRESTATIONS -->
  <section class="services-preview" id="services-preview">
    <p class="services-label">Mes prestations</p>
    <div class="services-stage" id="services-stage">
      {services.map((s) => (
        <a
          href={`/services#${s.id}`}
          class="service-item"
        >
          <div class="service-clip">
            <h3 class="service-name">{s.titre}</h3>
          </div>
        </a>
      ))}
      <div class="service-cta-slot services-cta-pin" id="services-cta-pin">
        <a href="/services" class="btn-secondary">Voir toutes les prestations</a>
      </div>
    </div>
  </section>

  <!-- A PROPOS -->
  <section class="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-text">
          <p class="about-eyebrow">KLIP KLAP</p>
          <p class="about-body">
            KLIP KLAP conçoit vos images cinématographiques où le regard, le temps et le contraste
            occupent une place centrale. Mon travail consiste à transformer une intention en récit
            visuel, en croisant ma vision créative avec celle du client. À travers des projets pour
            des artistes, des événements, des entreprises, le sport ou l'automobile, je cherche à
            créer des images qui racontent, qui respirent, et qui laissent une trace.
          </p>
          <a href="/contact" class="btn-primary" style="margin-top: 32px; display: inline-block;">Travaillons ensemble</a>
        </div>
        <div class="about-photo">
          <img
            src="/images/photo_profil.webp"
            alt="Ronan — Vidéaste et télépilote drone Klip Klap, Châtel-Guyon Auvergne"
            loading="lazy"
            width="1290"
            height="1037"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PROJETS SELECTION -->
  <section class="projets-selection" id="projets-selection">
    <div class="container">
      <h2 class="section-title-projets">Sélection</h2>
    </div>

    <div class="projets-scroll-outer">
    <div class="projets-grid-home" id="projets-scroll-track">
      <!-- Ordre fixe par catégorie ; contenu tiré au sort côté client -->
      <a href="/projets/fc-chatel-rc-riorges-feminin" class="projet-card-home" data-categorie="live-multicam">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/zPpQNie58MY/maxresdefault.jpg"
            alt="FC CHATEL — RC RIORGES FÉMININ"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">FC CHATEL — RC RIORGES FÉMININ</p>
          <span class="card-badge">Live multicam</span>
        </div>
      </a>

      <a href="/projets/halleatoires-2-aftermovie" class="projet-card-home" data-categorie="reseaux-sociaux">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/dWNUEOTkceA/maxresdefault.jpg"
            alt="HALLÉATOIRES 2 — AFTERMOVIE"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">HALLÉATOIRES 2 — AFTERMOVIE</p>
          <span class="card-badge">Réseaux sociaux</span>
        </div>
      </a>

      <a href="/projets/making-of-yavanti-episode-7" class="projet-card-home" data-categorie="corporate">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/sHLetqUg2T8/maxresdefault.jpg"
            alt="MAKING-OF Y'AVANTI EPISODE 7"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">MAKING-OF Y'AVANTI EPISODE 7</p>
          <span class="card-badge">Corporate</span>
        </div>
      </a>

      <a href="/projets/stjepan-scarabe" class="projet-card-home" data-categorie="clips">
        <div class="card-thumb">
          <img
            src="https://img.youtube.com/vi/EjVWHof0bkA/maxresdefault.jpg"
            alt="STJEPAN — SCARABÉ"
            loading="lazy"
            width="640"
            height="360"
          />
        </div>
        <div class="card-info">
          <p class="card-titre">STJEPAN — SCARABÉ</p>
          <span class="card-badge">Clips</span>
        </div>
      </a>
    </div>

    </div><!-- /projets-scroll-outer -->

  </section>

  <div class="projets-cta-wrap">
    <a href="/projets" class="btn-secondary">Voir tous les projets</a>
  </div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    gsap.registerPlugin(ScrollTrigger);

    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    var preview   = document.getElementById('services-preview');
    var items     = Array.from(document.querySelectorAll('.service-item'));
    var N         = items.length;
    var names     = Array.from(document.querySelectorAll('.service-name'));
    var ctaPin    = document.getElementById('services-cta-pin');
    var selection = document.getElementById('projets-selection');
    var track     = document.getElementById('projets-scroll-track');

    function initAnimations(desktop) {
      var scrollPerStep  = desktop ? 360 : 200;
      var scrubServices  = desktop ? 0.7 : 0.3;
      var scrubProjets   = desktop ? 0.6 : 0.3;

      if (preview && N >= 2) {
        gsap.set(names, { y: '150%' });
        gsap.set(names[0], { y: '0%' });
        gsap.set(items, { pointerEvents: 'none' });
        gsap.set(items[0], { pointerEvents: 'auto' });
        if (ctaPin) gsap.set(ctaPin, { autoAlpha: 0, pointerEvents: 'none' });

        var totalScroll = N * scrollPerStep;

        var tl = gsap.timeline({
          scrollTrigger: {
            trigger: preview,
            start: 'top top+=72',
            end: '+=' + totalScroll,
            pin: true,
            anticipatePin: 1,
            scrub: scrubServices,
            invalidateOnRefresh: true,
          }
        });

        for (var i = 0; i < N - 1; i++) {
          var t = i;
          tl.to(names[i],     { y: '-150%', duration: 0.28, ease: 'power3.in' }, t + 0.58);
          tl.to(items[i],     { pointerEvents: 'none', duration: 0.001 },         t + 0.58);
          tl.fromTo(names[i + 1],
            { y: '150%' },
            { y: '0%', duration: 0.28, ease: 'power3.out' },
            t + 0.70
          );
          tl.to(items[i + 1], { pointerEvents: 'auto', duration: 0.001 },         t + 0.70);
        }

        if (ctaPin) {
          tl.to(names[N - 1], { y: '-150%', duration: 0.28, ease: 'power3.in' }, (N - 1) + 0.55);
          tl.to(items[N - 1], { pointerEvents: 'none', duration: 0.001 },         (N - 1) + 0.55);
          tl.to(ctaPin,
            { autoAlpha: 1, pointerEvents: 'auto', duration: 0.25, ease: 'power2.out' },
            (N - 1) + 0.67
          );
        }
      }

      if (selection && track) {
        gsap.to(track, {
          x: function () { return -(track.scrollWidth - window.innerWidth); },
          ease: 'none',
          scrollTrigger: {
            trigger: selection,
            start: 'top top+=72',
            end: function () { return '+=' + (track.scrollWidth - window.innerWidth); },
            pin: true,
            anticipatePin: 1,
            scrub: scrubProjets,
            invalidateOnRefresh: true,
          }
        });
      }

      return function () {
        gsap.set(names, { clearProps: 'all' });
        gsap.set(items, { clearProps: 'all' });
        if (ctaPin) gsap.set(ctaPin, { clearProps: 'all' });
        if (track)    gsap.set(track,    { clearProps: 'all' });
      };
    }

    ScrollTrigger.matchMedia({
      '(min-width: 769px)': function () { return initAnimations(true);  },
      '(max-width: 768px)': function () { return initAnimations(false); },
    });
  });
</script>

<!-- ═══ HERO SCROLL ═══ -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var heroEl      = document.querySelector('.hero');
    var contentEl   = document.querySelector('.hero-content');
    var overlayEl   = document.querySelector('.hero-overlay');
    var videoEl     = document.querySelector('.hero-video-wrapper');
    if (!heroEl) return;

    // Retour bfcache — réinitialiser les props GSAP
    window.addEventListener('pageshow', function (e) {
      if (!e.persisted) return;
      if (contentEl) gsap.set(contentEl, { clearProps: 'opacity' });
      if (videoEl)   gsap.set(videoEl,   { clearProps: 'filter' });
      if (overlayEl) gsap.set(overlayEl, { clearProps: 'background' });
    });

    var tl = gsap.timeline({
      scrollTrigger: {
        trigger: heroEl,
        start: 'top top',
        end: '+=480',
        scrub: 1,
      }
    });

    // Fondu global du contenu hero en un seul bloc — différé à 30%
    if (contentEl) {
      tl.to(contentEl, {
        opacity: 0,
        ease: 'power2.in',
        duration: 0.7,
      }, 0.3);
    }

    // Flou vidéo
    if (videoEl) {
      tl.fromTo(videoEl,
        { filter: 'blur(0px)' },
        { filter: 'blur(14px)', ease: 'none', duration: 1 },
        0
      );
    }

    // Assombrissement overlay
    if (overlayEl) {
      tl.to(overlayEl, {
        background: 'rgba(0,0,0,0.82)',
        ease: 'none',
        duration: 1,
      }, 0);
    }
  });
</script>

<!-- ═══ SÉLECTION PROJETS ALÉATOIRE ═══
     Tirage côté client : change à chaque rechargement, indépendant du build. -->
<script define:vars={{ projetsJSON }}>
  (function () {
    var projets = JSON.parse(projetsJSON);
    var labels = {
      'live-multicam':   'Live multicam',
      'reseaux-sociaux': 'Réseaux sociaux',
      'corporate':       'Corporate',
      'clips':           'Clips',
    };

    document.querySelectorAll('.projet-card-home[data-categorie]').forEach(function (card) {
      var cat  = card.dataset.categorie;
      var pool = projets.filter(function (p) { return p.categorie === cat; });
      if (!pool.length) return;

      var projet = pool[Math.floor(Math.random() * pool.length)];

      card.href = '/projets/' + projet.slug;

      var img = card.querySelector('img');
      if (img) { img.src = projet.thumbnail; img.alt = projet.titre; }

      var titre = card.querySelector('.card-titre');
      if (titre) titre.textContent = projet.titre;

      var badge = card.querySelector('.card-badge');
      if (badge) badge.textContent = labels[cat] || cat;
    });
  })();
</script>
</BaseLayout>

<style>
  /* ═══ HERO ═══ */
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* overflow: hidden retiré — le clip de la vidéo est assuré par .hero-video-wrapper
       qui a son propre overflow:hidden. Laisser ici rogne les chars GSAP en bord d'écran. */
  }

  .hero-video-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-video-wrapper iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100vw, 177.78vh);
    height: max(56.25vw, 100vh);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    /* width: 100% nécessaire — flex-column align-items:center = shrink-to-fit par défaut */
    width: 100%;
    box-sizing: border-box;
    padding: 0 80px;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(64px, 12vw, 120px);
    color: #F5C800;
    -webkit-text-stroke: 4px #000;
    paint-order: stroke fill;
    text-shadow: none;
    line-height: 0.9;
    letter-spacing: 4px;
    margin-bottom: 20px;
    text-align: center;
    /* margin recule la boîte vers l'intérieur — le stroke du K et du P ne sort plus du conteneur */
    /* padding donne en plus une zone de peinture propre à chaque bord */
    margin-left: 0.15em;
    margin-right: 0.15em;
    padding: 0 0.15em;
    box-sizing: border-box;
  }

  .hero-sub {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-muted);
    margin-bottom: 48px;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-stats {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
  }

  /* ═══ BOUTONS ═══ */
  .btn-primary {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: #000;
    background: var(--color-primary);
    padding: 14px 32px;
    border: none;
    border-radius: 2px;
    transition: background var(--transition-fast), transform 100ms ease-out;
  }

  .btn-primary:hover {
    background: var(--color-primary-glow);
  }

  .btn-primary:active {
    transform: scale(0.97);
  }

  .btn-secondary {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: #fff;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    padding: 14px 32px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    transition: border-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast), transform 100ms ease-out;
  }

  .btn-secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: inset 0 1px 0 rgba(245, 200, 0, 0.2);
  }

  .btn-secondary:active {
    transform: scale(0.97);
  }

  /* ═══ CONTAINER ═══ */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ═══ PRESTATIONS ═══ */
  .services-preview {
    height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* Label hors du flux : ne tire pas le stage vers le bas */
  .services-label {
    position: absolute;
    top: 108px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-primary);
    white-space: nowrap;
  }

  /* Grille CSS : empile tous les items au même emplacement */
  .services-stage {
    display: grid;
    width: 100%;
    max-width: 1280px;
    padding: 0 32px;
  }

  .service-item {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }

  /* Conteneur de clip pour La Coupe — le texte déborde, le div masque */
  .service-clip {
    overflow: hidden;
    /* padding vertical pour que le texte ne soit pas rogné au baseline */
    padding: 0.1em 0;
  }

  .service-name {
    font-family: var(--font-body);
    font-size: clamp(80px, 14vw, 200px);
    font-weight: 200;
    color: #fff;
    line-height: 0.9;
    letter-spacing: -1px;
    text-align: center;
    display: block;
    transition: color 200ms ease;
  }

  .service-item:hover .service-name {
    color: var(--color-primary);
  }

  /* Slot CTA — empilé dans le même grid que les service-item, invisible par défaut */
  .service-cta-slot {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
  }

  .services-cta-pin .btn-secondary {
    font-size: 20px;
    padding: 20px 56px;
  }

  /* Mobile : mêmes effets que desktop, réglages adaptés */
  @media (max-width: 768px) {
    .services-preview {
      background: rgba(0, 0, 0, 0.92);
    }

    .services-label {
      top: 60px;
    }

    .services-cta-pin .btn-secondary {
      font-size: 16px;
      padding: 14px 32px;
    }
  }

  /* ═══ À PROPOS ═══ */
  .about {
    padding: 200px 0;
    background: #080808;
    border-top: 1px solid var(--color-border);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .about-eyebrow {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-primary);
    margin-bottom: 20px;
  }

  .about-body {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    color: #999;
    line-height: 1.8;
  }

  .about-photo img {
    width: 100%;
    max-width: 480px;
    height: auto;
    object-fit: contain;
    filter: grayscale(20%);
  }

  /* ═══ SÉLECTION PROJETS ═══ */
  .projets-selection {
    border-top: 1px solid var(--color-border);
  }

  .projets-selection .container {
    margin-bottom: 40px;
  }

  .section-title-projets {
    font-family: var(--font-body);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 300;
    color: #fff;
    letter-spacing: -0.5px;
    line-height: 1;
  }

  .projets-scroll-outer {
    overflow: hidden;
  }

  /* Desktop : section plein-écran pour le pin, piste horizontale débordante */
  @media (min-width: 769px) {
    .projets-selection {
      height: calc(100vh - 72px);
      padding: 60px 0 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 24px;
    }

    .projets-selection .container {
      margin-bottom: 0;
      flex-shrink: 0;
    }

    .projets-scroll-outer {
      overflow: hidden;
      flex: 1;
      display: flex;
      align-items: center;
      min-height: 0;
    }

    .projets-grid-home {
      padding: 0 32px;
      align-self: center;
    }
  }

  .projets-grid-home {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 16px;
    padding: 0 32px;
    will-change: transform;
  }

  .projets-grid-home .projet-card-home {
    flex: 0 0 42vw;
  }

  .projet-card-home {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #0d0d0d;
    border: 1px solid var(--color-border);
    transition: transform 200ms cubic-bezier(0.25, 0, 0, 1), border-color 200ms ease;
  }

  .projet-card-home:hover {
    transform: translateY(-6px);
    border-color: rgba(245, 200, 0, 0.35);
  }

  .card-thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }

  .projet-card-home:hover .card-thumb img {
    transform: scale(1.05);
  }

  .card-info {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-titre {
