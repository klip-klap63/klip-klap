---
import BaseLayout from '@/layouts/BaseLayout.astro';

const services = [
  {
    number: '01',
    title: 'Live Multicam',
    description: 'Réalisation en direct avec régie multicaméra — concerts, conférences, mariages, événements corporate.',
    href: '/live-multicam',
    highlight: true,
  },
  {
    number: '02',
    title: 'Vidéo Corporate',
    description: 'Films d\'entreprise et présentation de marque — mettre en valeur votre image professionnelle.',
    href: '/services',
    highlight: false,
  },
  {
    number: '03',
    title: 'Aftermovie',
    description: 'Captation et montage événementiel pour réseaux sociaux — faire revivre vos moments forts.',
    href: '/services',
    highlight: false,
  },
  {
    number: '04',
    title: 'Drone',
    description: 'Prises de vue aériennes par un télépilote diplômé DGAC — perspectives uniques et spectaculaires.',
    href: '/drone',
    highlight: false,
  },
  {
    number: '05',
    title: 'Clips musicaux',
    description: 'Réalisation de clips pour artistes — direction artistique, tournage et post-production.',
    href: '/clips-musicaux',
    highlight: false,
  },
  {
    number: '06',
    title: 'Interviews',
    description: 'Tournage et montage d\'interviews — format professionnel adapté à votre communication.',
    href: '/services',
    highlight: false,
  },
];

const stats = [
  { value: 'DGAC', label: 'Télépilote diplômé' },
  { value: '360°', label: 'Production complète' },
  { value: 'Live', label: 'Régie multicam' },
];
---

<BaseLayout
  title="Klip-Klap — Production audiovisuelle & Live Multicam"
  description="Société de production audiovisuelle indépendante — réalisation live multicam avec régie, vidéo corporate, drone DGAC, clips musicaux et aftermovie. Prestation complète de A à Z."
>

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">

    <!-- Background vidéo placeholder -->
    <div class="absolute inset-0 bg-[#050505]">
      <!-- [TEXTE À REMPLIR] : Remplacer par embed Vimeo/YouTube du showreel -->
      <!-- Pattern cinématographique -->
      <div class="absolute inset-0 opacity-[0.03]"
        style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.5) 2px, rgba(255,255,255,0.5) 3px); background-size: 100% 60px;">
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/80"></div>
    </div>

    <!-- Hero content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 py-24 text-center">

      <p class="eyebrow mb-6 lg:mb-8">Production audiovisuelle</p>

      <h1 class="font-display text-[clamp(52px,10vw,120px)] leading-none text-white mb-6">
        Klip<span class="text-primary">-</span>Klap
      </h1>

      <p class="font-body font-[300] text-[clamp(15px,2vw,18px)] text-[#999] max-w-2xl mx-auto leading-relaxed mb-12">
        Captation live, vidéo corporate, drone, clips musicaux —<br class="hidden md:block" />
        une vision créative, une maîtrise technique complète.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/live-multicam" class="btn-primary">Découvrir le live multicam</a>
        <a href="/contact" class="btn-secondary">Demander un devis</a>
      </div>

      <!-- Stats -->
      <div class="mt-20 lg:mt-28 grid grid-cols-3 gap-8 max-w-lg mx-auto border-t border-[#1A1A1A] pt-10">
        {stats.map((stat) => (
          <div class="text-center">
            <p class="font-display text-[28px] lg:text-[36px] text-primary leading-none mb-1">{stat.value}</p>
            <p class="label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
      <span class="font-body text-[10px] tracking-[0.3em] uppercase text-white">Scroll</span>
      <div class="w-px h-12 bg-gradient-to-b from-white to-transparent"></div>
    </div>
  </section>

  <!-- Intro bande -->
  <section class="border-y border-[#1A1A1A] bg-[#0D0D0D] py-5 overflow-hidden">
    <div class="flex gap-12 whitespace-nowrap animate-[marquee_30s_linear_infinite]">
      {Array.from({ length: 6 }).map(() => (
        <span class="flex items-center gap-12 text-[#333] font-body text-[11px] tracking-[0.3em] uppercase">
          <span>Réalisation live multicam</span>
          <span class="text-primary">—</span>
          <span>Vidéo corporate</span>
          <span class="text-primary">—</span>
          <span>Drone DGAC</span>
          <span class="text-primary">—</span>
          <span>Clips musicaux</span>
          <span class="text-primary">—</span>
          <span>Aftermovie</span>
          <span class="text-primary">—</span>
        </span>
      ))}
    </div>
  </section>

  <!-- Services grid -->
  <section class="max-w-7xl mx-auto px-6 lg:px-12 py-24 lg:py-36">
    <div class="mb-16 lg:mb-20">
      <p class="eyebrow mb-4">Ce que nous faisons</p>
      <h2 class="section-title">Nos expertises</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#1A1A1A]">
      {services.map((service) => (
        <a
          href={service.href}
          class={[
            'group relative block p-8 lg:p-10 transition-colors duration-250',
            service.highlight
              ? 'bg-primary text-black hover:bg-primary-glow'
              : 'bg-black hover:bg-[#0D0D0D]',
          ].join(' ')}
        >
          <div class="flex flex-col h-full min-h-[220px]">
            <span class={[
              'font-body text-[11px] tracking-[0.3em] uppercase mb-6 block',
              service.highlight ? 'text-black/60' : 'text-[#666]',
            ].join(' ')}>
              {service.number}
            </span>

            <h3 class={[
              'font-body font-[400] text-[22px] mb-4 leading-tight',
              service.highlight ? 'text-black' : 'text-white',
            ].join(' ')}>
              {service.title}
            </h3>

            <p class={[
              'font-body font-[300] text-[14px] leading-relaxed flex-1',
              service.highlight ? 'text-black/70' : 'text-[#999]',
            ].join(' ')}>
              {service.description}
            </p>

            <div class={[
              'mt-6 flex items-center gap-3 font-body text-[11px] tracking-[0.2em] uppercase transition-gap duration-150',
              service.highlight ? 'text-black' : 'text-primary',
            ].join(' ')}>
              <span>En savoir plus</span>
              <span class="group-hover:translate-x-1 transition-transform duration-150">—</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Live multicam focus -->
  <section class="bg-[#0D0D0D] border-y border-[#1A1A1A]">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 py-24 lg:py-36">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

        <div>
          <p class="eyebrow mb-4">Notre spécialité</p>
          <h2 class="section-title mb-6">Régie Live Multicam</h2>
          <div class="w-10 h-px bg-primary mb-8"></div>
          <p class="font-body font-[300] text-[15px] text-[#999] leading-relaxed mb-8">
            Concerts, conférences, mariages, streams, événements corporate —
            nous déployons une régie complète sur site pour une captation live en temps réel,
            multi-caméras, avec découpe et mixage en direct.
          </p>
          <p class="font-body font-[300] text-[15px] text-[#999] leading-relaxed mb-10">
            Le résultat est un flux vidéo professionnel diffusable en direct ou disponible
            immédiatement après l'événement, sans étape de montage longue.
          </p>
          <a href="/live-multicam" class="btn-primary">Découvrir le live multicam</a>
        </div>

        <!-- Visual placeholder -->
        <div class="relative aspect-video bg-black border border-[#2A2A2A] flex items-center justify-center overflow-hidden">
          <div class="grid grid-cols-2 gap-2 p-4 w-full h-full">
            <div class="bg-[#0A0A0A] border border-[#1A1A1A] flex items-center justify-center">
              <span class="label">CAM 1</span>
            </div>
            <div class="bg-[#0D0D0D] border border-[#2A2A2A] flex items-center justify-center">
              <span class="label">CAM 2</span>
            </div>
            <div class="bg-[#0A0A0A] border border-[#1A1A1A] flex items-center justify-center">
              <span class="label">CAM 3</span>
            </div>
            <div class="bg-primary/10 border border-primary flex items-center justify-center">
              <span class="label text-primary">LIVE</span>
            </div>
          </div>
          <div class="absolute top-3 right-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            <span class="font-body text-[10px] tracking-[0.2em] uppercase text-white/60">En direct</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="max-w-7xl mx-auto px-6 lg:px-12 py-24 lg:py-36 text-center">
    <p class="eyebrow mb-4">Travaillons ensemble</p>
    <h2 class="section-title mb-6">Un projet en tête ?</h2>
    <p class="font-body font-[300] text-[15px] text-[#999] max-w-xl mx-auto leading-relaxed mb-10">
      Que ce soit pour un événement live, un film corporate, du drone ou un clip —
      parlons-en et construisons quelque chose de marquant.
    </p>
    <a href="/contact" class="btn-primary">Prendre contact</a>
  </section>

</BaseLayout>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
