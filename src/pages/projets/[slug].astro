---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projets, categories } from '../../data/projets';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return projets.map((p) => ({
    params: { slug: p.slug },
    props: { projet: p },
  }));
};

const { projet } = Astro.props;
const categoryLabel = categories.find(c => c.id === projet.categorie)?.label ?? projet.categorie;
---

<BaseLayout
  title={`${projet.titre} — KLIP KLAP`}
  description={`${projet.titre} — Production vidéo KLIP KLAP`}
  ogImage={projet.thumbnail}
>
  <div class="projet-page">
    <div class="container">
      <a href="/projets" class="back-link">
        <span class="back-arrow">←</span> Tous les projets
      </a>

      <div class="projet-hero">
        <div class="yt-wrapper">
          <iframe
            src={`https://www.youtube.com/embed/${projet.youtube_id}?rel=0&modestbranding=1`}
            title={projet.titre}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="projet-content">
        <h1 class="projet-titre">{projet.titre}</h1>
        <span class="projet-category">{categoryLabel}</span>
        <a
          href={`https://youtu.be/${projet.youtube_id}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          Voir sur YouTube
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0);    }
    }

    .back-link   { animation: fade-up 500ms cubic-bezier(0.25, 0, 0, 1) 300ms both; }
    .projet-hero { animation: fade-up 500ms cubic-bezier(0.25, 0, 0, 1) 380ms both; }
    .projet-content { animation: fade-up 500ms cubic-bezier(0.25, 0, 0, 1) 460ms both; }
  }

  .projet-page {
    padding: 200px 0 200px;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
    margin-bottom: 56px;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .back-arrow {
    transition: transform var(--transition-fast);
  }

  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }

  .projet-hero {
    margin-bottom: 48px;
  }

  .yt-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: #0d0d0d;
  }

  .yt-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .projet-content {
    max-width: 640px;
  }

  .projet-meta {
    margin-bottom: 12px;
  }

  .projet-year {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-primary);
  }

  .projet-titre {
    font-family: var(--font-body);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 300;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 12px;
  }

  .projet-category {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-primary);
    margin-bottom: 28px;
  }

  .projet-desc {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    color: #999;
    line-height: 1.8;
    margin-bottom: 40px;
  }

  .btn-primary {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: #000;
    background: var(--color-primary);
    padding: 14px 32px;
    border: none;
    border-radius: 2px;
    display: inline-block;
    transition: background var(--transition-fast), transform 100ms ease-out;
  }

  .btn-primary:hover {
    background: var(--color-primary-glow);
  }

  .btn-primary:active {
    transform: scale(0.97);
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }

    .projet-page {
      padding: 110px 0 80px;
    }
  }
</style>
