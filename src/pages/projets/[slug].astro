---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projets } from '../../data/projets';
import type { GetStaticPaths } from 'astro';
export const getStaticPaths: GetStaticPaths = () => {
  return projets.map((p) => ({
    params: { slug: p.slug },
    props: { projet: p },
  }));
};
const { projet } = Astro.props;
---
<BaseLayout
  title={`${projet.titre} — KLIP KLAP`}
  description={`${projet.titre} — Production vidéo KLIP KLAP`}
  ogImage={projet.thumbnail}
>
  <div class="projet-page">
    <div class="container">
      <a href="/projets" class="back-link">
        <span class="back-arrow">←</span> Tous les projets
      </a>
      <div class="projet-hero">
        <div class="yt-wrapper">
          <iframe
            src={`https://www.youtube.com/embed/${projet.youtube_id}?rel=0&modestbranding=1`}
            title={projet.titre}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
      <div class="projet-content">
        <h1 class="projet-titre">{projet.titre}</h1>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .projet-page {
    padding: 140px 0 120px;
  }
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
    margin-bottom: 56px;
  }
  .back-link:hover {
    color: var(--color-primary);
  }
  .back-arrow {
    transition: transform var(--transition-fast);
  }
  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }
  .projet-hero {
    margin-bottom: 48px;
  }
  .yt-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: #0d0d0d;
  }
  .yt-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .projet-content {
    max-width: 640px;
  }
  .projet-titre {
    font-family: var(--font-body);
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 500;
    color: #fff;
    letter-spacing: 2px;
    line-height: 1.1;
    text-transform: uppercase;
    margin-bottom: 0;
  }
  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }
    .projet-page {
      padding: 110px 0 80px;
    }
  }
</style>
