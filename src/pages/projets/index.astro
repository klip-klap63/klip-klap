---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projets } from '../../data/projets';
---

<BaseLayout
  title="Projets — KLIP KLAP | Portfolio audiovisuel"
  description="Découvrez les projets de KLIP KLAP : aftermovies, clips musicaux, interviews, corporate, drone. Portfolio audiovisuel."
>
  <div class="page-header">
    <div class="container">
      <p class="page-eyebrow">PORTFOLIO</p>
      <h1 class="page-title">Projets</h1>
    </div>
  </div>

  <ul class="projets-grid">
    {projets.map((p) => (
      <li>
        <a href={`/projets/${p.slug}`} class="projet-card">
          <img
            src={p.thumbnail}
            alt={p.titre}
            loading="lazy"
            width="640"
            height="360"
            onerror="this.src='/images/thumb-fallback.jpg'"
          />
          <div class="projet-overlay">
            <h2 class="projet-titre">{p.titre}</h2>
          </div>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .page-header {
    padding: 160px 0 80px;
    border-bottom: 1px solid var(--color-border);
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .page-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 80px);
    color: #fff;
    line-height: 1;
    letter-spacing: 2px;
  }

  /* GRILLE */
  .projets-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .projet-card {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .projet-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .projet-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    transition: opacity 300ms ease;
    display: flex;
    align-items: flex-end;
    padding: 24px 28px;
  }

  .projet-card:hover .projet-overlay {
    opacity: 1;
  }

  .projet-titre {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #fff;
    line-height: 1.4;
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 20px;
    }

    .page-header {
      padding: 120px 0 56px;
    }

    .projets-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
