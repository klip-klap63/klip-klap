---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projets, categories } from '../../data/projets';

const projetsJSON = JSON.stringify(projets);
---

<BaseLayout
  title="Projets — KLIP KLAP | Portfolio vidéaste Clermont-Ferrand & Auvergne"
  description="Portfolio de KLIP KLAP, vidéaste à Clermont-Ferrand : aftermovies, clips musicaux, interviews, films corporate, captations drone en Auvergne et Puy-de-Dôme."
>
  <section class="projets-page">

    <div class="page-header container">
      <p class="eyebrow">Portfolio</p>
      <h1 class="page-title">PROJETS</h1>
    </div>

    <!-- Filtres sticky -->
    <div class="filters-bar">
      <div class="filters-inner">
        {categories.map((cat) => (
          <button
            class={`filter-btn${cat.id === 'tous' ? ' active' : ''}`}
            data-filter={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Compteur -->
    <div class="container">
      <p class="compteur"><span id="count">{projets.length}</span> projets</p>
    </div>

    <!-- Grille -->
    <div class="grid-wrapper">
      <ul class="projets-grid" id="projets-grid">
        {projets.map((p) => (
          <li class="projet-item" data-categorie={p.categorie}>
            <a
              href={`/projets/${p.slug}`}
              class="projet-card"
              aria-label={p.titre}
            >
              <img
                src={p.thumbnail}
                alt={p.titre}
                loading="lazy"
                width="640"
                height="360"
                onerror="this.src='/images/thumb-fallback.jpg'"
              />
              <div class="projet-overlay">
                <p class="overlay-titre">{p.titre}</p>
                <span class="overlay-badge">{
                  categories.find(c => c.id === p.categorie)?.label ?? p.categorie
                }</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>

  </section>
</BaseLayout>

<style>
  .projets-page {
    padding-top: 140px;
    padding-bottom: 120px;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* Header */
  .page-header {
    padding-bottom: 56px;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 96px);
    color: #fff;
    line-height: 1;
    letter-spacing: 2px;
  }

  /* Filtres sticky */
  .filters-bar {
    position: sticky;
    top: 72px;
    z-index: 50;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 14px 32px;
    margin-bottom: 32px;
  }

  .filters-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .filters-inner::-webkit-scrollbar {
    display: none;
  }

  .filter-btn {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease, color 150ms ease, box-shadow 150ms ease;
  }

  .filter-btn:hover:not(.active) {
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .filter-btn.active {
    background: var(--color-primary);
    color: #000;
    border-color: var(--color-primary);
    box-shadow: none;
    font-weight: 500;
  }

  /* Compteur */
  .compteur {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  /* Grille */
  .grid-wrapper {
    width: 100%;
  }

  .projets-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    width: 100%;
  }

  .projet-item {
    /* pas de bordure */
  }

  /* Card */
  .projet-card {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .projet-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }

  .projet-card:hover img {
    transform: scale(1.04);
  }

  /* Overlay liquid glass — visible au hover uniquement */
  .projet-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    /* fond sombre + blur fort sur l'image derrière = glass maximal */
    background: rgba(0, 0, 0, 0.52);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .projet-card:hover .projet-overlay {
    opacity: 1;
  }

  .overlay-titre {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    color: #ffffff;
    letter-spacing: 0;
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .overlay-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 4px 10px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0;
    align-self: flex-start;
  }

  /* Masqué par filtrage */
  .projet-item.hidden {
    display: none;
  }

  /* Responsive */
  @media (max-width: 600px) {
    .projets-page {
      padding-top: 110px;
    }

    .container {
      padding: 0 20px;
    }

    .filters-bar {
      padding: 12px 20px;
    }

    .projets-grid {
      grid-template-columns: 1fr;
    }
  }

</style>

<script define:vars={{ projetsJSON }}>
  const projets = JSON.parse(projetsJSON);
  const grid = document.getElementById('projets-grid');

  // Shuffle Fisher-Yates — une seule fois au chargement
  if (grid) {
    const cards = Array.from(grid.children);
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    cards.forEach(card => grid.appendChild(card));
  }
  const countEl = document.getElementById('count');
  const btns = document.querySelectorAll('.filter-btn');

  const hasGsap = typeof window !== 'undefined' && typeof window.gsap !== 'undefined';

  function filterProjects(filterId) {
    const items = grid.querySelectorAll('.projet-item');
    const visible = [];
    const hidden = [];

    items.forEach((item) => {
      const cat = item.dataset.categorie;
      if (filterId === 'tous' || cat === filterId) {
        visible.push(item);
      } else {
        hidden.push(item);
      }
    });

    hidden.forEach((el) => { el.classList.add('hidden'); });
    visible.forEach((el) => { el.classList.remove('hidden'); });

    if (hasGsap && visible.length) {
      window.gsap.fromTo(
        visible,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.35, stagger: 0.04, ease: 'power2.out' }
      );
    }

    if (countEl) countEl.textContent = String(visible.length);
  }

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      btns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      filterProjects(btn.dataset.filter);
    });
  });
</script>
