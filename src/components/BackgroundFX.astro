---
---

<canvas id="bg-fx" aria-hidden="true"></canvas>

<style>
  #bg-fx {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
  }
</style>

<script>
  // Désactivé sur mobile / touch
  if (!window.matchMedia('(pointer: fine)').matches) {
    // rien à faire
  } else {
    const canvas = document.getElementById('bg-fx') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;

    const CELL        = 40;       // taille de la cellule de grille en px
    const MAX_DISP    = 7;        // déplacement max d'un point vers le curseur
    const INFLUENCE   = 220;      // rayon d'influence du curseur sur la grille
    const LERP        = 0.06;     // vitesse d'interpolation (doux)
    const ALPHA_REST  = 0.08;     // opacité des traits au repos
    const ALPHA_NEAR  = 0.22;     // opacité des traits près du curseur
    const PART_RADIUS = 120;      // rayon de spawn des particules
    const PART_RATE   = 0.35;     // probabilité de spawn par événement mousemove

    let cols = 0;
    let rows = 0;

    interface GridPoint {
      ox: number; oy: number; // position d'origine
      cx: number; cy: number; // position courante (interpolée)
    }

    interface Particle {
      x: number; y: number;
      vx: number; vy: number;
      size: number;
      baseAlpha: number;
      life: number;
      maxLife: number;
    }

    let grid: GridPoint[] = [];
    const particles: Particle[] = [];
    const mouse = { x: -9999, y: -9999 };

    // --- Grille ---
    function buildGrid() {
      cols = Math.ceil(canvas.width  / CELL) + 2;
      rows = Math.ceil(canvas.height / CELL) + 2;
      grid = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const ox = c * CELL;
          const oy = r * CELL;
          grid.push({ ox, oy, cx: ox, cy: oy });
        }
      }
    }

    function pt(c: number, r: number): GridPoint {
      return grid[r * cols + c];
    }

    function resize() {
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
      buildGrid();
    }

    // --- Update ---
    function update() {
      // Déplacement des points de grille vers le curseur
      for (const p of grid) {
        const dx   = mouse.x - p.ox;
        const dy   = mouse.y - p.oy;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const fall = Math.max(0, 1 - dist / INFLUENCE);
        const tx   = p.ox + (dx / dist) * MAX_DISP * fall * fall;
        const ty   = p.oy + (dy / dist) * MAX_DISP * fall * fall;
        p.cx += (tx - p.cx) * LERP;
        p.cy += (ty - p.cy) * LERP;
      }

      // Particules
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.life--;
        p.x += p.vx;
        p.y += p.vy;
        if (p.life <= 0) particles.splice(i, 1);
      }
    }

    // --- Draw ---
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.lineWidth = 1;

      // Lignes horizontales
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols - 1; c++) {
          const a = pt(c,     r);
          const b = pt(c + 1, r);
          const dist = Math.sqrt((a.ox - mouse.x) ** 2 + (a.oy - mouse.y) ** 2);
          const t    = Math.max(0, 1 - dist / INFLUENCE);
          const alpha = ALPHA_REST + (ALPHA_NEAR - ALPHA_REST) * t * t;
          ctx.strokeStyle = `rgba(245,200,0,${alpha.toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(a.cx, a.cy);
          ctx.lineTo(b.cx, b.cy);
          ctx.stroke();
        }
      }

      // Lignes verticales
      for (let r = 0; r < rows - 1; r++) {
        for (let c = 0; c < cols; c++) {
          const a = pt(c, r);
          const b = pt(c, r + 1);
          const dist = Math.sqrt((a.ox - mouse.x) ** 2 + (a.oy - mouse.y) ** 2);
          const t    = Math.max(0, 1 - dist / INFLUENCE);
          const alpha = ALPHA_REST + (ALPHA_NEAR - ALPHA_REST) * t * t;
          ctx.strokeStyle = `rgba(245,200,0,${alpha.toFixed(3)})`;
          ctx.beginPath();
          ctx.moveTo(a.cx, a.cy);
          ctx.lineTo(b.cx, b.cy);
          ctx.stroke();
        }
      }

      // Particules
      for (const p of particles) {
        const progress = p.life / p.maxLife;
        const alpha    = progress * p.baseAlpha;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(245,200,0,${alpha.toFixed(3)})`;
        ctx.fill();
      }
    }

    // --- Loop ---
    function loop() {
      update();
      draw();
      requestAnimationFrame(loop);
    }

    // --- Événements ---
    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;

      if (Math.random() < PART_RATE) {
        const angle   = Math.random() * Math.PI * 2;
        const r       = Math.random() * PART_RADIUS;
        const maxLife = 30 + Math.floor(Math.random() * 21); // 30–50
        particles.push({
          x:         mouse.x + Math.cos(angle) * r,
          y:         mouse.y + Math.sin(angle) * r,
          vx:        (Math.random() - 0.5) * 0.6,
          vy:        (Math.random() - 0.5) * 0.6,
          size:      1 + Math.random() * 2,             // 1–3 px
          baseAlpha: 0.1 + Math.random() * 0.3,         // 0.1–0.4
          life:      maxLife,
          maxLife,
        });
      }
    });

    window.addEventListener('resize', resize, { passive: true });

    resize();
    loop();
  }
</script>
