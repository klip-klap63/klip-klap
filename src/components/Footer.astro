<style>
  /* Le canvas est positionné à cheval sur la limite footer / contenu :
     30px au-dessus (fond page #000), 30px en dessous (fond footer).
     Fond transparent — aucune couleur propre. */
  footer {
    background: var(--color-surface);
    margin-top: 120px;
    position: relative;
  }

  #footer-pixels {
    position: absolute;
    top: -30px;
    left: 0;
    width: 100%;   /* width explicite requis sur les éléments canvas remplacés */
    height: 60px;
    background: transparent;
    pointer-events: none;
    z-index: 1;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 72px 32px 40px;
  }

  /* ── Grille 4 colonnes ─────────────────────────────────────────────── */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 48px;
    margin-bottom: 64px;
  }

  .footer-logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 32px;
    color: var(--color-primary);
    letter-spacing: 2px;
    line-height: 1;
    transition: color var(--transition-fast);
  }

  .footer-logo:hover {
    color: var(--color-primary-glow);
  }

  .footer-tagline {
    margin-top: 20px;
    max-width: 28ch;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  /* Petit repère doré au-dessus de chaque colonne (direction « La Coupe ») */
  .footer-label {
    margin-bottom: 20px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-primary);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-col a,
  .footer-text {
    display: inline-flex;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-col a:hover {
    color: var(--color-text);
  }

  /* Icônes au trait, alignées sur la graisse 300 du texte */
  .icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 1px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
  }

  .footer-col a:hover .icon {
    color: var(--color-primary);
  }

  /* ── Barre du bas ──────────────────────────────────────────────────── */
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .copy,
  .copy-link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  .copy-link {
    transition: color var(--transition-fast);
  }

  .copy-link:hover {
    color: var(--color-text);
  }

  /* ── Tablette : 2 colonnes ─────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 48px 32px;
    }
  }

  /* ── Mobile : identité pleine largeur, puis colonnes empilées ─────── */
  @media (max-width: 640px) {
    .footer-inner {
      padding: 56px 20px 32px;
    }

    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
      margin-bottom: 48px;
    }

    .footer-brand,
    .footer-grid > .footer-col:last-child {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

<script>
  (function () {
    var canvas = document.getElementById('footer-pixels') as HTMLCanvasElement;
    if (!canvas) return;
    var ctx = canvas.getContext('2d')!;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Constantes ────────────────────────────────────────────────────────
    var CANVAS_H  = 60;   // 30px au-dessus + 30px en dessous de la frontière
    var BORDER_Y  = 30;   // y de la frontière dans le canvas
    var SCATTER   = 22;   // dispersion max depuis BORDER_Y (centre du carré)
    var SIZE_MIN  = 18;
    var SIZE_MAX  = 28;
    var FADE_MS   = 200;
    var LIFE_MIN  = 1000;
    var LIFE_MAX  = 2500;
    var CNT_MIN   = 3;    // carrés simultanés minimum
    var CNT_MAX   = 6;    // carrés simultanés maximum

    interface Sq {
      x: number; y: number; size: number;
      type: 'gold' | 'black';
      life: number; maxLife: number; alpha: number;
    }

    var squares: Sq[] = [];
    var spawnCd  = 0;
    var spawnTgt = CNT_MIN + Math.floor(Math.random() * (CNT_MAX - CNT_MIN + 1));
    var active   = false;
    var rafId: number | null = null;
    var lastTs   = 0;

    // ── Spawn ─────────────────────────────────────────────────────────────
    function spawn() {
      if (canvas.width < 10) return;
      var size = SIZE_MIN + Math.floor(Math.random() * (SIZE_MAX - SIZE_MIN + 1));
      // Centre du carré proche de la frontière, avec dispersion aléatoire
      var cy   = BORDER_Y + (Math.random() * 2 - 1) * SCATTER;
      var y    = Math.max(0, Math.min(CANVAS_H - size, Math.round(cy - size / 2)));
      var x    = Math.round(size + Math.random() * (canvas.width - size * 2));

      // Distance minimale avec les carrés existants
      for (var i = 0; i < squares.length; i++) {
        var s  = squares[i];
        var dx = s.x + s.size / 2 - (x + size / 2);
        var dy = s.y + s.size / 2 - (y + size / 2);
        if (Math.sqrt(dx * dx + dy * dy) < size + s.size + 6) return;
      }

      var life = LIFE_MIN + Math.random() * (LIFE_MAX - LIFE_MIN);
      squares.push({
        x, y, size,
        type: Math.random() < 0.28 ? 'black' : 'gold',
        life, maxLife: life, alpha: 0,
      });
    }

    // ── Update ────────────────────────────────────────────────────────────
    function update(dt: number) {
      for (var i = squares.length - 1; i >= 0; i--) {
        var s   = squares[i];
        s.life -= dt;
        var el  = s.maxLife - s.life;
        s.alpha = Math.min(1, Math.min(el, Math.max(0, s.life)) / FADE_MS);
        if (s.life <= 0) squares.splice(i, 1);
      }

      // Révise la cible de temps en temps
      if (Math.random() < 0.002) {
        spawnTgt = CNT_MIN + Math.floor(Math.random() * (CNT_MAX - CNT_MIN + 1));
      }

      spawnCd -= dt;
      if (spawnCd <= 0 && squares.length < spawnTgt) {
        spawn();
        spawnCd = squares.length < spawnTgt - 2
          ? 80 + Math.random() * 120
          : 250 + Math.random() * 500;
      }
    }

    // ── Rendu — fond transparent, aucune bande ────────────────────────────
    function draw() {
      ctx.clearRect(0, 0, canvas.width, CANVAS_H);

      for (var i = 0; i < squares.length; i++) {
        var s = squares[i];
        if (s.alpha < 0.005) continue;
        ctx.fillStyle = s.type === 'gold'
          ? 'rgba(245,200,0,' + s.alpha + ')'
          : 'rgba(0,0,0,' + s.alpha + ')';
        ctx.fillRect(s.x, s.y, s.size, s.size);
      }
    }

    // ── Boucle ────────────────────────────────────────────────────────────
    function loop(ts: number) {
      var dt = Math.min(ts - lastTs, 100);
      lastTs = ts;
      update(dt);
      draw();
      if (active) rafId = requestAnimationFrame(loop);
    }

    // ── Rendu statique (reduced-motion) ───────────────────────────────────
    function drawStatic() {
      ctx.clearRect(0, 0, canvas.width, CANVAS_H);
      var pts = [0.15, 0.32, 0.51, 0.67, 0.82];
      ctx.fillStyle = 'rgba(245,200,0,0.70)';
      pts.forEach(function (f, i) {
        var sz = 9 + (i % 3);
        var cy = BORDER_Y + (i % 2 === 0 ? -8 : 10);
        ctx.fillRect(Math.round(f * canvas.width), Math.round(cy - sz / 2), sz, sz);
      });
    }

    // ── Resize ────────────────────────────────────────────────────────────
    function resize() {
      // getBoundingClientRect().width donne la largeur CSS réelle, même si le
      // buffer width du canvas écrase offsetWidth/clientWidth sur les replaced elements
      var w = Math.round(canvas.getBoundingClientRect().width);
      if (!w) w = window.innerWidth || 300;
      canvas.width  = w;
      canvas.height = CANVAS_H;
      squares       = [];
      spawnCd       = 0;
    }

    // ── IntersectionObserver ──────────────────────────────────────────────
    var observer = new IntersectionObserver(function (entries) {
      var visible = entries[0].isIntersecting;
      if (visible && !active && !reduced) {
        active = true;
        lastTs = performance.now();
        rafId  = requestAnimationFrame(loop);
      } else if (!visible && active) {
        active = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      }
    }, { threshold: 0.01 });

    resize();
    observer.observe(canvas);

    if (reduced) drawStatic();

    window.addEventListener('resize', function () {
      var was = active;
      if (was) { active = false; if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; } }
      resize();
      if (reduced) drawStatic();
      else if (was) { active = true; lastTs = performance.now(); rafId = requestAnimationFrame(loop); }
    }, { passive: true });
  })();
</script>
