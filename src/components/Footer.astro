---
const year = new Date().getFullYear();
---

<footer>
  <canvas id="footer-wave" aria-hidden="true"></canvas>
  <div class="footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-logo" aria-label="KLIP KLAP">KLIP KLAP</a>

      <nav aria-label="Navigation secondaire">
        <ul>
          <li><a href="/services">prestations</a></li>
          <li><a href="/projets">projets</a></li>
          <li><a href="/contact">contact</a></li>
          <li><a href="/mentions-legales">mentions légales</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="address">39 rue Jean Groslier — Châtel-Guyon</p>
      <p class="copy">&copy; {year} KLIP KLAP. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  /* La bordure haute est remplacée par le canvas d'onde */
  #footer-wave {
    display: block;
    width: 100%;
    height: 48px;
  }

  footer {
    background: var(--color-surface);
    margin-top: 120px;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 32px 40px;
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-primary);
    letter-spacing: 2px;
    line-height: 1;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .footer-logo:hover {
    color: var(--color-primary-glow);
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    justify-content: flex-end;
  }

  nav a {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
  }

  nav a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .address {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  .copy {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding: 40px 20px 32px;
    }

    .footer-top {
      flex-direction: column;
      gap: 24px;
    }

    nav ul {
      justify-content: flex-start;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

<script>
  (function () {
    var canvas = document.getElementById('footer-wave') as HTMLCanvasElement;
    if (!canvas) return;
    var ctx = canvas.getContext('2d')!;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var active = false;
    var rafId: number | null = null;

    function resize() {
      canvas.width  = canvas.offsetWidth;
      canvas.height = 48;
    }

    // Trace une sinusoïde — ts en millisecondes, speedMul = vitesse de phase, freqMul = nb de cycles
    function drawWave(ts: number, speedMul: number, freqMul: number, amp: number, alpha: number) {
      var W = canvas.width;
      var mid = canvas.height / 2;
      var phase = (ts / 1000) * speedMul;

      ctx.beginPath();
      for (var x = 0; x <= W; x++) {
        var y = mid + Math.sin((x / W) * Math.PI * 2 * freqMul + phase) * amp;
        if (x === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = 'rgba(245, 200, 0, ' + alpha + ')';
      ctx.lineWidth  = 1.5;
      ctx.lineJoin   = 'round';
      ctx.stroke();
    }

    function render(ts: number) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 3 ondes de fréquences et vitesses différentes — opacités 100/40/20%
      var t = reduced ? 0 : ts;
      drawWave(t, 0.45, 4.0, 15, 1.0);   // onde principale — lente
      drawWave(t, 0.30, 5.5, 10, 0.4);   // harmonique médiane
      drawWave(t, 0.18, 7.2,  6, 0.2);   // harmonique haute — très douce

      if (active && !reduced) rafId = requestAnimationFrame(render);
    }

    // Pause quand le footer sort du viewport
    var observer = new IntersectionObserver(function (entries) {
      var visible = entries[0].isIntersecting;
      if (visible && !active) {
        active = true;
        rafId = requestAnimationFrame(render);
      } else if (!visible && active) {
        active = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      }
    }, { threshold: 0.01 });

    observer.observe(canvas);
    resize();

    // Onde statique pour prefers-reduced-motion
    if (reduced) requestAnimationFrame(render);

    window.addEventListener('resize', function () {
      resize();
      if (reduced) requestAnimationFrame(render);
    }, { passive: true });
  })();
</script>
