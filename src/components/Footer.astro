---
const year = new Date().getFullYear();
---

<footer>
  <canvas id="footer-spectrum" aria-hidden="true"></canvas>
  <div class="footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-logo" aria-label="KLIP KLAP">KLIP KLAP</a>

      <nav aria-label="Navigation secondaire">
        <ul>
          <li><a href="/services">prestations</a></li>
          <li><a href="/projets">projets</a></li>
          <li><a href="/contact">contact</a></li>
          <li><a href="/mentions-legales">mentions légales</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="address">39 rue Jean Groslier — Châtel-Guyon</p>
      <p class="copy">&copy; {year} KLIP KLAP. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  /* Spectre audio — barre du bord haut du footer */
  #footer-spectrum {
    display: block;
    width: 100%;
    height: 28px;
  }

  footer {
    background: var(--color-surface);
    margin-top: 120px;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 32px 40px;
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-primary);
    letter-spacing: 2px;
    line-height: 1;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .footer-logo:hover {
    color: var(--color-primary-glow);
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    justify-content: flex-end;
  }

  nav a {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
  }

  nav a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .address {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  .copy {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding: 40px 20px 32px;
    }

    .footer-top {
      flex-direction: column;
      gap: 24px;
    }

    nav ul {
      justify-content: flex-start;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

<script>
  (function () {
    var canvas = document.getElementById('footer-spectrum') as HTMLCanvasElement;
    if (!canvas) return;
    var ctx = canvas.getContext('2d')!;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var active  = false;
    var rafId: number | null = null;

    // ── Paramètres ──────────────────────────────────────────────────────────
    var PITCH  = 12;   // px entre deux barres (barre + espace)
    var BAR_W  = 2;    // largeur de chaque barre en px
    var MAX_H  = 22;   // hauteur max en px
    var MIN_H  = 4;    // hauteur min quand active
    var LERP   = 0.10; // vitesse de lissage (0–1, plus petit = plus doux)
    var IDLE_P = 0.58; // probabilité qu'une barre repasse à 0 lors d'un changement

    interface Bar {
      x:        number;
      currentH: number;
      targetH:  number;
      countdown: number;
    }

    var bars: Bar[] = [];

    // ── Initialisation des barres ────────────────────────────────────────────
    function initBars(width: number) {
      var count = Math.floor(width / PITCH);
      // Conserver les barres existantes si possible (redimensionnement)
      var prev  = bars.slice();
      bars = [];
      for (var i = 0; i < count; i++) {
        var p = prev[i];
        bars.push({
          x:         i * PITCH + Math.floor((PITCH - BAR_W) / 2),
          currentH:  p ? p.currentH : 0,
          targetH:   p ? p.targetH  : (reduced ? randomH() : 0),
          countdown: p ? p.countdown : Math.floor(Math.random() * 90),
        });
      }
    }

    function randomH(): number {
      return MIN_H + Math.random() * (MAX_H - MIN_H);
    }

    // ── Mise à jour d'une barre par frame ────────────────────────────────────
    function updateBar(b: Bar) {
      b.countdown--;
      if (b.countdown <= 0) {
        if (Math.random() < IDLE_P) {
          b.targetH   = 0;
          b.countdown = 18 + Math.floor(Math.random() * 70); // 0.3–1.5 s @ 60fps
        } else {
          b.targetH   = randomH();
          b.countdown = 12 + Math.floor(Math.random() * 55); // 0.2–1.1 s
        }
      }
      // Lissage exponentiel — transitions douces sans saut
      b.currentH += (b.targetH - b.currentH) * LERP;
    }

    // ── Rendu ────────────────────────────────────────────────────────────────
    function render() {
      var H = canvas.height;
      ctx.clearRect(0, 0, canvas.width, H);
      ctx.fillStyle = '#F5C800';

      for (var i = 0; i < bars.length; i++) {
        var b = bars[i];
        if (!reduced) updateBar(b);
        if (b.currentH > 0.3) {
          // Barres ancrées au bas du canvas (= bord haut du footer)
          ctx.fillRect(b.x, H - b.currentH, BAR_W, b.currentH);
        }
      }

      if (active && !reduced) rafId = requestAnimationFrame(render);
    }

    // ── Redimensionnement ─────────────────────────────────────────────────────
    function resize() {
      canvas.width  = canvas.offsetWidth;
      canvas.height = 28;
      initBars(canvas.width);
      if (reduced) render(); // un seul dessin statique
    }

    // ── IntersectionObserver — pause hors écran ───────────────────────────────
    var observer = new IntersectionObserver(function (entries) {
      var visible = entries[0].isIntersecting;
      if (visible && !active && !reduced) {
        active = true;
        rafId  = requestAnimationFrame(render);
      } else if (!visible && active) {
        active = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      }
    }, { threshold: 0.01 });

    observer.observe(canvas);
    resize();

    window.addEventListener('resize', function () {
      var wasActive = active;
      if (wasActive) {
        active = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      }
      resize();
      if (wasActive && !reduced) {
        active = true;
        rafId  = requestAnimationFrame(render);
      }
    }, { passive: true });
  })();
</script>
