---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-logo" aria-label="KLIP KLAP">KLIP KLAP</a>

      <nav aria-label="Navigation secondaire">
        <ul>
          <li><a href="/services">prestations</a></li>
          <li><a href="/projets">projets</a></li>
          <li><a href="/contact">contact</a></li>
          <li><a href="/mentions-legales">mentions légales</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="address">39 rue Jean Groslier — Châtel-Guyon</p>
      <p class="copy">&copy; {year} KLIP KLAP. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    margin-top: 120px;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 32px 40px;
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-primary);
    letter-spacing: 2px;
    line-height: 1;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .footer-logo:hover {
    color: var(--color-primary-glow);
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    justify-content: flex-end;
  }

  nav a {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
  }

  nav a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .address {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  .copy {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding: 40px 20px 32px;
    }

    .footer-top {
      flex-direction: column;
      gap: 24px;
    }

    nav ul {
      justify-content: flex-start;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
