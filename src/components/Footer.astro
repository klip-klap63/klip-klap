---
const year = new Date().getFullYear();

const links = [
  { href: '/live-multicam', label: 'Live Multicam' },
  { href: '/services', label: 'Services' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/drone', label: 'Drone' },
  { href: '/clips-musicaux', label: 'Clips musicaux' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="border-t border-[#1A1A1A] bg-[#0D0D0D]">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <img
          src="/logo/logo_klip_klap.png"
          alt="Klip-Klap"
          class="h-12 w-auto object-contain mb-6"
          loading="lazy"
        />
        <p class="text-[#999] font-body font-[300] text-[14px] leading-relaxed max-w-xs">
          Société de production audiovisuelle indépendante — films, événements, live multicam, drone.
        </p>
        <div class="mt-6 flex items-center gap-2">
          <span class="w-8 h-px bg-primary"></span>
          <span class="label">Production audiovisuelle</span>
        </div>
      </div>

      <!-- Nav -->
      <div>
        <p class="eyebrow mb-6">Navigation</p>
        <nav class="flex flex-col gap-3">
          {links.map((link) => (
            <a
              href={link.href}
              class="font-body text-[13px] text-[#888] hover:text-white transition-colors duration-150 tracking-wide w-fit"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <p class="eyebrow mb-6">Contact</p>
        <div class="flex flex-col gap-4">
          <div>
            <p class="label mb-1">Email</p>
            <p class="text-[#999] font-body text-[14px]">[TEXTE À REMPLIR]</p>
          </div>
          <div>
            <p class="label mb-1">Téléphone</p>
            <p class="text-[#999] font-body text-[14px]">[TEXTE À REMPLIR]</p>
          </div>
          <div>
            <p class="label mb-1">Zone d'intervention</p>
            <p class="text-[#999] font-body text-[14px]">[TEXTE À REMPLIR]</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-[#1A1A1A] mt-12 pt-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <p class="text-[#666] font-body text-[12px] tracking-wide">
        &copy; {year} Klip-Klap. Tous droits réservés.
      </p>
      <div class="flex gap-6">
        <a href="/mentions-legales" class="text-[#666] font-body text-[12px] tracking-wide hover:text-[#999] transition-colors duration-150">
          Mentions légales
        </a>
      </div>
    </div>
  </div>
</footer>
