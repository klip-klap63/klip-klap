---
const year = new Date().getFullYear();
---

<footer>
  <canvas id="footer-pixels" aria-hidden="true"></canvas>
  <div class="footer-inner">
    <div class="footer-top">
      <a href="/" class="footer-logo" aria-label="KLIP KLAP">KLIP KLAP</a>

      <nav aria-label="Navigation secondaire">
        <ul>
          <li><a href="/services">prestations</a></li>
          <li><a href="/projets">projets</a></li>
          <li><a href="/contact">contact</a></li>
          <li><a href="/mentions-legales">mentions légales</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="address">39 rue Jean Groslier — Châtel-Guyon</p>
      <p class="copy">&copy; {year} KLIP KLAP. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  #footer-pixels {
    display: block;
    width: 100%;
    /* hauteur gérée par JS via canvas.style.height */
  }

  footer {
    background: var(--color-surface);
    margin-top: 120px;
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 32px 40px;
  }

  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 48px;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--color-primary);
    letter-spacing: 2px;
    line-height: 1;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .footer-logo:hover {
    color: var(--color-primary-glow);
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    justify-content: flex-end;
  }

  nav a {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
  }

  nav a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .address {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  .copy {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding: 40px 20px 32px;
    }

    .footer-top {
      flex-direction: column;
      gap: 24px;
    }

    nav ul {
      justify-content: flex-start;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>

<script>
  (function () {
    var canvas = document.getElementById('footer-pixels') as HTMLCanvasElement;
    if (!canvas) return;
    var ctx = canvas.getContext('2d')!;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ── Constantes ────────────────────────────────────────────────────────
    var ROWS      = 4;      // 2 au-dessus de la frontière + 2 en dessous
    var BORDER    = 2;      // frontière entre row 1 et row 2
    var FADE_MS   = 250;    // ms de fondu entrant / sortant
    var LIFE_MIN  = 1000;   // ms
    var LIFE_MAX  = 4000;

    // Fond légèrement plus clair dans la zone basse — rend les carrés noirs visibles
    var BG_BELOW  = 'rgba(36,36,36,0.90)';
    var CLR_GOLD  = 'rgba(245,200,0,';
    var CLR_BLACK = 'rgba(0,0,0,';

    // ── État ─────────────────────────────────────────────────────────────
    interface Sq {
      col: number; row: number; span: number;
      type: 'gold' | 'black';
      life: number; maxLife: number; alpha: number;
    }

    var squares: Sq[] = [];
    var occ: Record<string, boolean> = {};
    var spawnCd  = 0;
    var active   = false;
    var rafId: number | null = null;
    var lastTs   = 0;

    // ── Helpers ───────────────────────────────────────────────────────────
    function mobile()      { return window.innerWidth <= 768; }
    function cell()        { return mobile() ? 10 : 16; }
    function target()      { return mobile() ? 6 : 10; }
    function k(c: number, r: number) { return c + ',' + r; }

    function setOcc(col: number, row: number, span: number, val: boolean) {
      occ[k(col, row)] = val;
      if (span === 2) occ[k(col, row + 1)] = val;
    }

    function isOcc(col: number, row: number) { return !!occ[k(col, row)]; }

    // ── Spawn d'un carré (et parfois un voisin adjacent) ──────────────────
    function spawn() {
      var C    = cell();
      var cols = Math.floor(canvas.width / C);
      if (cols === 0) return;

      for (var t = 0; t < 40; t++) {
        var isGold   = Math.random() < 0.5;
        var baseRow  = isGold ? 0 : BORDER;
        // Préférence pour la rangée qui touche la frontière
        var row      = baseRow + (Math.random() < 0.6 ? (isGold ? 1 : 0) : (isGold ? 0 : 1));
        var col      = Math.floor(Math.random() * cols);

        // Span 2 uniquement si la rangée de base est libre sur 2 hauteurs
        var canSpan2 = (row === baseRow) && !isOcc(col, row + 1) && (row + 1 < ROWS);
        var span     = (canSpan2 && Math.random() < 0.25) ? 2 : 1;

        if (isOcc(col, row) || (span === 2 && isOcc(col, row + 1))) continue;

        var life = LIFE_MIN + Math.random() * (LIFE_MAX - LIFE_MIN);
        var sq: Sq = { col, row, span, type: isGold ? 'gold' : 'black', life, maxLife: life, alpha: 0 };
        setOcc(col, row, span, true);
        squares.push(sq);

        // Voisin horizontal (clustering)
        if (Math.random() < 0.30) {
          var nc = col + (Math.random() < 0.5 ? 1 : -1);
          if (nc >= 0 && nc < cols && !isOcc(nc, row)) {
            var nLife = LIFE_MIN + Math.random() * (LIFE_MAX - LIFE_MIN);
            var ns: Sq = { col: nc, row, span: 1, type: sq.type, life: nLife, maxLife: nLife, alpha: 0 };
            setOcc(nc, row, 1, true);
            squares.push(ns);
          }
        }
        return;
      }
    }

    // ── Update ────────────────────────────────────────────────────────────
    function update(dt: number) {
      for (var i = squares.length - 1; i >= 0; i--) {
        var s    = squares[i];
        s.life  -= dt;
        var el   = s.maxLife - s.life;
        s.alpha  = Math.min(1, Math.min(el, Math.max(0, s.life)) / FADE_MS);
        if (s.life <= 0) {
          setOcc(s.col, s.row, s.span, false);
          squares.splice(i, 1);
        }
      }

      spawnCd -= dt;
      if (spawnCd <= 0 && squares.length < target()) {
        spawn();
        var deficit = target() - squares.length;
        spawnCd = deficit > 4
          ? 60  + Math.random() * 120   // remontée rapide si très en dessous
          : 200 + Math.random() * 450;  // rythme lent proche de la cible
      }
    }

    // ── Rendu ─────────────────────────────────────────────────────────────
    function draw() {
      var C = cell();
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Zone inférieure : fond légèrement plus clair pour que les carrés noirs ressortent
      ctx.fillStyle = BG_BELOW;
      ctx.fillRect(0, BORDER * C, canvas.width, (ROWS - BORDER) * C);

      for (var i = 0; i < squares.length; i++) {
        var s = squares[i];
        var a = s.alpha;
        if (a < 0.005) continue;
        ctx.fillStyle = (s.type === 'gold' ? CLR_GOLD : CLR_BLACK) + a + ')';
        ctx.fillRect(s.col * C, s.row * C, C, s.span * C);
      }
    }

    // ── Boucle principale ─────────────────────────────────────────────────
    function loop(ts: number) {
      var dt = Math.min(ts - lastTs, 100);
      lastTs = ts;
      update(dt);
      draw();
      if (active) rafId = requestAnimationFrame(loop);
    }

    // ── Rendu statique (reduced-motion) ───────────────────────────────────
    function drawStatic() {
      var C    = cell();
      var cols = Math.floor(canvas.width / C);
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      ctx.fillStyle = BG_BELOW;
      ctx.fillRect(0, BORDER * C, canvas.width, (ROWS - BORDER) * C);

      // Quelques carrés or figés en rangée 1 (collée à la frontière)
      ctx.fillStyle = 'rgba(245,200,0,0.72)';
      [0.12, 0.28, 0.44, 0.60, 0.76].forEach(function (f) {
        var c = Math.floor(f * cols);
        ctx.fillRect(c * C, 1 * C, C, C);
      });

      // Quelques carrés noirs figés en rangée 2
      ctx.fillStyle = 'rgba(0,0,0,0.85)';
      [0.20, 0.37, 0.52, 0.69].forEach(function (f) {
        var c = Math.floor(f * cols);
        ctx.fillRect(c * C, BORDER * C, C, C);
      });
    }

    // ── Resize ────────────────────────────────────────────────────────────
    function resize() {
      var C            = cell();
      canvas.width     = canvas.offsetWidth;
      canvas.height    = ROWS * C;
      canvas.style.height = (ROWS * C) + 'px';
      squares          = [];
      occ              = {};
      spawnCd          = 0;
    }

    // ── IntersectionObserver ──────────────────────────────────────────────
    var observer = new IntersectionObserver(function (entries) {
      var visible = entries[0].isIntersecting;
      if (visible && !active && !reduced) {
        active = true;
        lastTs = performance.now();
        rafId  = requestAnimationFrame(loop);
      } else if (!visible && active) {
        active = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
      }
    }, { threshold: 0.01 });

    resize();
    observer.observe(canvas);

    if (reduced) drawStatic();

    window.addEventListener('resize', function () {
      var was = active;
      if (was) { active = false; if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; } }
      resize();
      if (reduced) drawStatic();
      else if (was) { active = true; lastTs = performance.now(); rafId = requestAnimationFrame(loop); }
    }, { passive: true });
  })();
</script>
