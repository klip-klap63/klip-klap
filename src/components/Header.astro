---
const navLinks = [
  { href: '/', label: 'accueil' },
  { href: '/services', label: 'prestations' },
  { href: '/projets', label: 'projets' },
  { href: '/contact', label: 'contact' },
];

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header id="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="KLIP KLAP — Accueil">
      KLIP KLAP
    </a>

    <nav aria-label="Navigation principale">
      <ul>
        {navLinks.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class:list={['nav-link', { active: isActive(href) }]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<!-- Enfant direct de <body> via le layout — hors du contexte d'empilement du header -->
<div id="mobile-nav" aria-hidden="true">
  {navLinks.map(({ href, label }) => (
    <a
      href={href}
      class:list={[{ active: isActive(href) }]}
      aria-current={isActive(href) ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
</div>

<style>
  /* ═══ HEADER ═══ */
  #site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background var(--transition-base), border-color var(--transition-base), backdrop-filter var(--transition-base);
  }

  #site-header.scrolled {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 32px;
    color: var(--color-primary);
    letter-spacing: 2px;
    line-height: 1;
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .logo:hover {
    color: var(--color-primary-glow);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 40px;
    list-style: none;
  }

  .nav-link {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 300;
    letter-spacing: 0;
    color: var(--color-text-subtle);
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .nav-link.active::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link.active {
    color: var(--color-primary);
  }

  /* ═══ BURGER ═══ */
  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: none;
    padding: 4px;
    z-index: 10001;
    position: relative;
  }

  .burger span {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--color-text);
    transition: transform 300ms cubic-bezier(0.65, 0, 0.35, 1), opacity 200ms ease;
  }

  /* ═══ MENU MOBILE — toujours display:flex, caché hors-écran par transform ═══ */
  #mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(32px) saturate(180%);
    -webkit-backdrop-filter: blur(32px) saturate(180%);
    transform: translateX(100%);
    transition: transform 500ms cubic-bezier(0.65, 0, 0.35, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }

  #mobile-nav.open {
    transform: translateX(0);
  }

  #mobile-nav a {
    font-family: var(--font-body);
    font-size: 32px;
    font-weight: 300;
    color: var(--color-text-subtle);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 300ms ease, transform 300ms ease, color var(--transition-fast);
    text-decoration: none;
  }

  #mobile-nav a.active {
    color: var(--color-primary);
  }

  #mobile-nav.open a {
    opacity: 1;
    transform: translateY(0);
  }

  #mobile-nav.open a:nth-child(1) { transition-delay: 200ms; }
  #mobile-nav.open a:nth-child(2) { transition-delay: 260ms; }
  #mobile-nav.open a:nth-child(3) { transition-delay: 320ms; }
  #mobile-nav.open a:nth-child(4) { transition-delay: 380ms; }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 768px) {
    .header-inner {
      padding: 0 20px;
      height: 60px;
    }

    .logo {
      font-size: 26px;
    }

    nav {
      display: none;
    }

    .burger {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav,
    #mobile-nav a,
    .burger span {
      transition: none !important;
    }
  }
</style>

<script>
  const burger = document.querySelector('.burger') as HTMLButtonElement;
  const mobileNav = document.getElementById('mobile-nav');

  function openNav() {
    mobileNav?.classList.add('open');
    burger.setAttribute('aria-expanded', 'true');
    mobileNav?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    const spans = burger.querySelectorAll('span');
    (spans[0] as HTMLElement).style.transform = 'translateY(6px) rotate(45deg)';
    (spans[1] as HTMLElement).style.opacity = '0';
    (spans[2] as HTMLElement).style.transform = 'translateY(-6px) rotate(-45deg)';
  }

  function closeNav() {
    mobileNav?.classList.remove('open');
    burger?.setAttribute('aria-expanded', 'false');
    mobileNav?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    const spans = burger?.querySelectorAll('span');
    if (spans) {
      (spans[0] as HTMLElement).style.transform = '';
      (spans[1] as HTMLElement).style.opacity = '';
      (spans[2] as HTMLElement).style.transform = '';
    }
  }

  burger?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.contains('open');
    if (isOpen) closeNav(); else openNav();
  });

  mobileNav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeNav);
  });

  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });
</script>
