---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import BackgroundFX from '../components/BackgroundFX.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'KLIP KLAP — Production audiovisuelle : live multicam, drone DGAC, clips, corporate, réseaux sociaux.',
  ogImage = '/og-default.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="keywords" content="vidéaste Clermont-Ferrand, production audiovisuelle Auvergne, live multicam Clermont-Ferrand, télépilote drone DGAC Puy-de-Dôme, clips musicaux Clermont-Ferrand, régie multicaméra Auvergne, captation vidéo événementiel, film corporate Clermont-Ferrand, aftermovie Auvergne, KLIP KLAP" />
    <meta name="geo.region" content="FR-63" />
    <meta name="geo.placename" content="Châtel-Guyon, Puy-de-Dôme" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- GSAP + ScrollTrigger via CDN — defer garantit l'exécution avant DOMContentLoaded -->
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <!-- Helvetica Now Display — auto-hébergé, préchargé pour affichage immédiat -->
    <link rel="preload" href="/fonts/HelveticaNowDisplay-ExtLt.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/HelveticaNowDisplay-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/HelveticaNowDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/HelveticaNowDisplay-Medium.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Road Rage — auto-hébergé, préchargé pour affichage immédiat -->
    <link rel="preload" href="/fonts/Road_Rage.otf" as="font" type="font/otf" crossorigin />

    <!-- Vimeo — preconnect pour réduire la latence d'initialisation -->
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />
    <link rel="preconnect" href="https://f.vimeocdn.com" />
    <link rel="dns-prefetch" href="https://fresnel.vimeocdn.com" />

    <title>{title}</title>

    <style>
      #page-curtain {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #000000;
        transform: scaleY(0);
        transform-origin: top;
        z-index: 9999;
        pointer-events: none;
      }

      #kk-loader {
        position: fixed;
        inset: 0;
        background: #000000;
        z-index: 10001;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 28px;
        pointer-events: none;
        transform: translateY(0);
        transition: transform 0.65s cubic-bezier(0.76, 0, 0.24, 1);
      }
      #kk-loader.exit { transform: translateY(-100%); }

      #kk-num {
        font-family: 'Helvetica Now Display', 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: clamp(80px, 16vw, 180px);
        font-weight: 200;
        color: #ffffff;
        letter-spacing: -0.03em;
        line-height: 1;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
      }
      #kk-bar-track {
        width: 200px;
        height: 1px;
        background: rgba(245, 200, 0, 0.18);
        position: relative;
        overflow: hidden;
      }
      #kk-bar {
        position: absolute;
        left: 0; top: 0;
        height: 100%;
        width: 0;
        background: #F5C800;
      }
    </style>

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Klip Klap",
        "description": "Production audiovisuelle à Châtel-Guyon et en Auvergne. Live multicam jusqu'à 8 caméras, télépilote drone certifié DGAC, clips musicaux, films corporate, vidéo événementielle.",
        "url": "https://klip-klap.fr",
        "logo": "https://klip-klap.fr/og-default.jpg",
        "image": "https://klip-klap.fr/og-default.jpg",
        "telephone": "+33663292671",
        "email": "klipklap63@hotmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "39 rue Jean Groslier",
          "addressLocality": "Châtel-Guyon",
          "postalCode": "63140",
          "addressRegion": "Auvergne-Rhône-Alpes",
          "addressCountry": "FR"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 45.9167,
          "longitude": 3.0667
        },
        "areaServed": [
          "Châtel-Guyon",
          "Clermont-Ferrand",
          "Riom",
          "Vichy",
          "Thiers",
          "Issoire",
          "Puy-de-Dôme",
          "Auvergne-Rhône-Alpes"
        ],
        "priceRange": "€€",
        "openingHours": "Mo-Fr 09:00-19:00",
        "sameAs": [
          "https://www.instagram.com/klip.klap__/",
          "https://www.facebook.com/p/KLIP-KLAP-100075680977037/",
          "https://www.linkedin.com/in/ronan-fayt-5a7227268/"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Services audiovisuels",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Live multicam", "description": "Diffusion en direct multicaméra jusqu'à 8 caméras — concerts, festivals, événements en Auvergne" }},
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Drone DGAC", "description": "Prises de vue aériennes par drone, télépilote certifié DGAC A1/A2/A3 CATS STS-01 STS-02" }},
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Clips musicaux", "description": "Réalisation de clips musicaux pour artistes à Clermont-Ferrand et en Auvergne" }},
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Film corporate", "description": "Films d'entreprise cinématographiques pour sociétés en Auvergne et Clermont-Ferrand" }},
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Vidéo événementielle", "description": "Captation vidéo événementielle tous supports — réseaux sociaux, web, TV, diffusion live" }}
          ]
        }
      }
    </script>
  </head>
  <body>
    <div id="kk-loader" aria-hidden="true">
      <span id="kk-num">000</span>
      <div id="kk-bar-track"><div id="kk-bar"></div></div>
    </div>

    <script is:inline>
      /* Masquage synchrone : sessionStorage ou reduced-motion → pas de loader */
      (function () {
        try {
          if (
            sessionStorage.getItem('kk_loaded') ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            var el = document.getElementById('kk-loader');
            if (el) el.style.display = 'none';
          }
        } catch (_) {}
      })();
    </script>

    <script is:inline>
      (function () {
        /* ── 4. Tout dans un try/catch ─────────────────────────────────── */
        try {
          var loader  = document.getElementById('kk-loader');
          var numEl   = document.getElementById('kk-num');
          var barEl   = document.getElementById('kk-bar');
          if (!loader || loader.style.display === 'none') return;

          var displayed = 0;
          var target    = 0;
          var exiting   = false;

          function pad(n) {
            return String(Math.min(100, Math.max(0, Math.round(n)))).padStart(3, '0');
          }

          function updateDisplay() {
            if (numEl) numEl.textContent = pad(displayed);
            if (barEl) barEl.style.width = (displayed / 100 * 200) + 'px';
          }

          function setTarget(pct) {
            var p = Math.min(100, Math.max(0, Math.round(pct)));
            if (p > target) target = p;
          }

          function doExit() {
            if (exiting) return;
            exiting = true;
            displayed = 100;
            updateDisplay();
            try { sessionStorage.setItem('kk_loaded', '1'); } catch (_) {}
            setTimeout(function () {
              if (!loader) return;
              loader.classList.add('exit');
              setTimeout(function () {
                if (loader && loader.parentNode) loader.parentNode.removeChild(loader);
              }, 700);
            }, 160);
          }

          /* ── 1. FILET DE SÉCURITÉ — première ligne, jamais annulé ──── */
          setTimeout(doExit, 2500);

          /* ── Ticker irrégulier ──────────────────────────────────────── */
          function tick() {
            if (exiting) return;
            if (displayed < target) {
              var step = Math.random() < 0.15 ? 2 + Math.floor(Math.random() * 2) : 1;
              displayed = Math.min(displayed + step, target);
              updateDisplay();
            }
            if (displayed >= 100) { doExit(); return; }
            var delay = 20 + Math.random() * 50;
            if (Math.random() < 0.08) delay += 180 + Math.random() * 260;
            setTimeout(tick, delay);
          }
          setTimeout(tick, 30);

          /* ── 2. Suivi fiable : images non-lazy uniquement ───────────── */
          /*    Iframes Vimeo/YouTube : ignorées                           */
          document.addEventListener('DOMContentLoaded', function () {
            setTarget(12); /* DOM parsé */

            var imgs = Array.prototype.slice.call(
              document.querySelectorAll('img')
            ).filter(function (img) {
              return img.getAttribute('loading') !== 'lazy';
            });

            /* ── 3. Aucune ressource fiable → sortie directe ──────────── */
            if (imgs.length === 0) {
              finishWithFonts();
              return;
            }

            var total = imgs.length;
            var done  = 0;

            function onDone() {
              done++;
              setTarget(12 + Math.round((done / total) * 76)); /* 12 → 88 */
              if (done >= total) finishWithFonts();
            }

            imgs.forEach(function (img) {
              if (img.complete) { onDone(); }
              else {
                img.addEventListener('load',  onDone);
                img.addEventListener('error', onDone);
              }
            });
          });

          function finishWithFonts() {
            try {
              if (document.fonts && document.fonts.ready) {
                document.fonts.ready
                  .then(function () { setTarget(100); })
                  .catch(function () { setTarget(100); });
              } else {
                setTarget(100);
              }
            } catch (_) { setTarget(100); }
          }

          /* Bfcache : retirer le loader si toujours présent */
          window.addEventListener('pageshow', function (e) {
            if (e.persisted && loader && loader.parentNode) {
              loader.parentNode.removeChild(loader);
            }
          });

        } catch (e) {
          /* ── 4. Erreur JS → sortie immédiate ───────────────────────── */
          try {
            var l = document.getElementById('kk-loader');
            if (l && l.parentNode) l.parentNode.removeChild(l);
          } catch (_) {}
        }
      })();
    </script>

    <div id="page-curtain"></div>
    <BackgroundFX />
    <CustomCursor />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        if (typeof gsap === 'undefined') return;
        if (typeof ScrollTrigger !== 'undefined') gsap.registerPlugin(ScrollTrigger);

        var curtain = document.getElementById('page-curtain');
        var transitioning = true;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function hideCurtain() {
          gsap.killTweensOf(curtain);
          gsap.set(curtain, { scaleY: 0, transformOrigin: 'bottom' });
          transitioning = false;
        }

        // Rideau d'entrée — remonte juste après le chargement de la nouvelle page
        gsap.fromTo(curtain,
          { scaleY: 1, transformOrigin: 'bottom' },
          {
            scaleY: 0,
            duration: reduced ? 0 : 0.7,
            ease: 'power3.inOut',
            delay: reduced ? 0 : 0.1,
            onComplete: function () { transitioning = false; }
          }
        );

        // Retour bfcache (bouton précédent/suivant) — DOMContentLoaded ne se déclenche pas
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) hideCurtain();
        });

        // Délai de sécurité — rideau retiré quoi qu'il arrive après 2s
        setTimeout(hideCurtain, 2000);

        document.addEventListener('click', function (e) {
          if (transitioning) return;

          var link = e.target.closest('a');
          if (!link) return;
          var href = link.getAttribute('href');
          if (
            !href ||
            href.startsWith('#') ||
            href.startsWith('http') ||
            href.startsWith('mailto') ||
            link.target === '_blank'
          ) return;

          e.preventDefault();
          transitioning = true;
          gsap.killTweensOf(curtain);

          // Rideau de sortie — descend, puis navigation
          gsap.fromTo(curtain,
            { scaleY: 0, transformOrigin: 'top' },
            {
              scaleY: 1,
              duration: reduced ? 0 : 0.6,
              ease: 'power3.inOut',
              onComplete: function () {
                window.location.href = href;
              }
            }
          );
        });
      });
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        if (typeof gsap === 'undefined') return;
        document.querySelectorAll('.btn-primary, .btn-secondary').forEach(function (btn) {
          var xTo = gsap.quickTo(btn, 'x', { duration: 0.6, ease: 'power3.out' });
          var yTo = gsap.quickTo(btn, 'y', { duration: 0.6, ease: 'power3.out' });

          btn.addEventListener('mousemove', function (e) {
            var rect = btn.getBoundingClientRect();
            var cx = rect.left + rect.width / 2;
            var cy = rect.top + rect.height / 2;
            xTo((e.clientX - cx) * 0.35);
            yTo((e.clientY - cy) * 0.35);
          });

          btn.addEventListener('mouseleave', function () {
            xTo(0);
            yTo(0);
          });
        });
      });
    </script>
  </body>
</html>
