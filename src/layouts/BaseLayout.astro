---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CustomCursor from '../components/CustomCursor.astro';
import BackgroundFX from '../components/BackgroundFX.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'KLIP KLAP — Production audiovisuelle : live multicam, drone DGAC, clips, corporate, réseaux sociaux.',
  ogImage = '/og-default.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="keywords" content="vidéaste Clermont-Ferrand, production audiovisuelle Auvergne, live multicam Clermont-Ferrand, télépilote drone DGAC Puy-de-Dôme, clips musicaux Clermont-Ferrand, régie multicaméra Auvergne, captation vidéo événementiel, film corporate Clermont-Ferrand, aftermovie Auvergne, KLIP KLAP" />
    <meta name="geo.region" content="FR-63" />
    <meta name="geo.placename" content="Châtel-Guyon, Puy-de-Dôme" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts — Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500&display=swap" rel="stylesheet" />

    <!-- Road Rage -->
    <link rel="preload" href="/fonts/Road_Rage.otf" as="font" type="font/otf" crossorigin />

    <!-- Vimeo preconnect -->
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />
    <link rel="preconnect" href="https://f.vimeocdn.com" />
    <link rel="dns-prefetch" href="https://fresnel.vimeocdn.com" />

    <title>{title}</title>

    <style>
      #page-curtain {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #000000;
        transform: scaleY(0);
        transform-origin: top center;
        z-index: 9999;
        pointer-events: none;
      }
    </style>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Klip Klap",
        "description": "Production audiovisuelle à Châtel-Guyon et en Auvergne. Live multicam jusqu'à 8 caméras, télépilote drone certifié DGAC, clips musicaux, films corporate, vidéo événementielle.",
        "url": "https://klip-klap.fr",
        "logo": "https://klip-klap.fr/og-default.jpg",
        "image": "https://klip-klap.fr/og-default.jpg",
        "telephone": "+33663292671",
        "email": "klipklap63@hotmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "39 rue Jean Groslier",
          "addressLocality": "Châtel-Guyon",
          "postalCode": "63140",
          "addressRegion": "Auvergne-Rhône-Alpes",
          "addressCountry": "FR"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 45.9167,
          "longitude": 3.0667
        },
        "areaServed": ["Châtel-Guyon","Clermont-Ferrand","Riom","Vichy","Thiers","Issoire","Puy-de-Dôme","Auvergne-Rhône-Alpes"],
        "priceRange": "€€",
        "openingHours": "Mo-Fr 09:00-19:00",
        "sameAs": [
          "https://www.instagram.com/klip.klap__/",
          "https://www.facebook.com/p/KLIP-KLAP-100075680977037/",
          "https://www.linkedin.com/in/ronan-fayt-5a7227268/"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Services audiovisuels",
          "itemListElement": [
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Live multicam" }},
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Drone DGAC" }},
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Clips musicaux" }},
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Film corporate" }},
            { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Vidéo événementielle" }}
          ]
        }
      }
    </script>
  </head>
  <body>
    <div id="page-curtain"></div>
    <BackgroundFX />
    <CustomCursor />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // ── RIDEAU DE TRANSITION ──────────────────────────────────────────────
      const curtain = document.getElementById('page-curtain') as HTMLElement;
      const EASE = 'cubic-bezier(0.76, 0, 0.24, 1)';

      function curtainDown(): Promise<void> {
        return new Promise(resolve => {
          curtain.style.transformOrigin = 'top center';
          curtain.style.transition = `transform 0.55s ${EASE}`;
          curtain.style.transform = 'scaleY(1)';
          curtain.addEventListener('transitionend', () => resolve(), { once: true });
        });
      }

      function curtainUp(): void {
        curtain.style.transformOrigin = 'bottom center';
        curtain.style.transition = `transform 0.6s ${EASE}`;
        curtain.style.transform = 'scaleY(0)';
      }

      // Ouvre le rideau à l'arrivée sur la page
      window.addEventListener('load', () => {
        curtain.style.transform = 'scaleY(1)';
        curtain.style.transformOrigin = 'bottom center';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => curtainUp());
        });
      });

      // Intercepte les clics sur les liens internes
      document.addEventListener('click', async (e: MouseEvent) => {
        const link = (e.target as HTMLElement).closest('a');
        if (!link) return;
        const href = link.getAttribute('href');
        if (
          !href ||
          href.startsWith('#') ||
          href.startsWith('http') ||
          href.startsWith('mailto') ||
          link.target === '_blank'
        ) return;
        e.preventDefault();
        await curtainDown();
        window.location.href = href;
      });

      // ── MAGNETIC BUTTONS ─────────────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('.btn-primary, .btn-secondary').forEach(btn => {
        let cx = 0, cy = 0, tx = 0, ty = 0;
        let rafId = 0;
        let active = false;

        function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

        function animate() {
          cx = lerp(cx, tx, 0.1);
          cy = lerp(cy, ty, 0.1);
          btn.style.transform = `translate(${cx.toFixed(2)}px, ${cy.toFixed(2)}px)`;
          if (Math.abs(cx - tx) > 0.05 || Math.abs(cy - ty) > 0.05) {
            rafId = requestAnimationFrame(animate);
          } else {
            btn.style.transform = `translate(${tx}px, ${ty}px)`;
            active = false;
          }
        }

        btn.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = btn.getBoundingClientRect();
          const dx = e.clientX - (rect.left + rect.width / 2);
          const dy = e.clientY - (rect.top + rect.height / 2);
          tx = dx * 0.35;
          ty = dy * 0.35;
          if (!active) { active = true; rafId = requestAnimationFrame(animate); }
        });

        btn.addEventListener('mouseleave', () => {
          tx = 0;
          ty = 0;
          if (!active) { active = true; rafId = requestAnimationFrame(animate); }
        });
      });
    </script>
  </body>
</html>
